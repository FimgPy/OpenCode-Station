# ~/.bashrc for user dev (CMD emulation environment)

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Resolve active environment from manifest if OPENCODE_ENV is not already set
if [ -z "$OPENCODE_ENV" ] && [ -f /var/envs/manifest.json ]; then
    OPENCODE_ENV=$(python3 -c "import json; print(json.load(open('/var/envs/manifest.json')).get('active', 'default'))" 2>/dev/null || echo "default")
fi
export OPENCODE_ENV="${OPENCODE_ENV:-default}"

if [ "$OPENCODE_ENV" = "default" ]; then
    export HOME="/home/dev"
    export OPENCODE_TEST_HOME="/home/dev"
    export XDG_DATA_HOME="/home/dev/.local/share"
    export XDG_CONFIG_HOME="/home/dev/.config"
    export XDG_STATE_HOME="/home/dev/.local/state"
    export XDG_CACHE_HOME="/home/dev/.cache"
else
    export HOME="/var/envs/${OPENCODE_ENV}/home"
    export OPENCODE_TEST_HOME="/var/envs/${OPENCODE_ENV}/home"
    export XDG_DATA_HOME="/var/envs/${OPENCODE_ENV}/home/.local/share"
    export XDG_CONFIG_HOME="/var/envs/${OPENCODE_ENV}/home/.config"
    export XDG_STATE_HOME="/var/envs/${OPENCODE_ENV}/home/.local/state"
    export XDG_CACHE_HOME="/var/envs/${OPENCODE_ENV}/home/.cache"
fi

# Source global bashrc
if [ -f /etc/bash.bashrc ]; then
    . /etc/bash.bashrc
fi

# History configuration
HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s histappend
shopt -s checkwinsize

# Proxy & CMD mode initialization
if [ -f /etc/profile.d/00-opencode-init.sh ]; then
    . /etc/profile.d/00-opencode-init.sh
fi
if [ -f /etc/profile.d/cmd_mode.sh ]; then
    . /etc/profile.d/cmd_mode.sh
fi

# Start in environment workspace
if [ "$OPENCODE_ENV" = "default" ]; then
    cd /home/dev/workspace/default 2>/dev/null || true
elif [ -n "$OPENCODE_ENV" ] && [ -d "/var/envs/${OPENCODE_ENV}/workspace" ]; then
    cd "/var/envs/${OPENCODE_ENV}/workspace" 2>/dev/null || true
fi
