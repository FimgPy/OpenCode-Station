#!/bin/bash
# Classic CMD style help for OpenCode Workstation
# Сделано Антоном Ковалкиным все права защищены.
echo "Справка по командам командной строки OpenCode (CMD-режим)"
echo "Сделано Антоном Ковалкиным все права защищены."
echo ""
echo "Для получения справки о конкретной команде введите: help <команда>"
echo ""
printf "%-18s %s\n" "AI [запрос]"        "Быстрое выполнение запроса OpenCode (например: ai создай змейку)"
printf "%-18s %s\n" "CD"                 "Смена текущей папки (поддерживает cd.. и d:)"
printf "%-18s %s\n" "CLS"                "Очистка экрана консоли"
printf "%-18s %s\n" "COPY"               "Копирование файлов (copy файл1 файл2)"
printf "%-18s %s\n" "DEL / ERASE"        "Удаление файлов (del файл)"
printf "%-18s %s\n" "DIR"                "Вывод списка файлов и подпапок в каталоге (dir /w)"
printf "%-18s %s\n" "ENV / ENVS"         "Список всех сред в ряд и таблицей (env list)"
printf "%-18s %s\n" "ENV CREATE [имя]"   "Создать абсолютно новую анонимную среду и папку на диске D"
printf "%-18s %s\n" "ENV SWITCH <имя>"   "Переключиться в другую среду (или: switch <имя>)"
printf "%-18s %s\n" "ENV CLEAN [имя]"    "Очистить кэш, историю диалогов и выдать новый Machine ID"
printf "%-18s %s\n" "ENV PURGE"          "Очистить все неактивные среды, оставив только default"
printf "%-18s %s\n" "EXIT"               "Завершение сеанса / возврат из среды"
printf "%-18s %s\n" "EXPORT"             "Экспорт файлов: export all, export select, export *.txt"
printf "%-18s %s\n" "HELP"               "Справка по командам консоли"
printf "%-18s %s\n" "LINUX / LDIR"       "Просмотр файлов и проектов в файловой системе Linux"
printf "%-18s %s\n" "MD / MKDIR"         "Создание папки (md новая_папка)"
printf "%-18s %s\n" "MOVE"               "Перемещение файлов"
printf "%-18s %s\n" "MYIP / IP"          "Проверить текущий внешний IP-адрес и маршрутизацию"
printf "%-18s %s\n" "OPEN"               "Открыть текущую папку в Проводнике Windows"
printf "%-18s %s\n" "OPENCODE"           "Интерактивный полноэкранный интерфейс OpenCode"
printf "%-18s %s\n" "PROXY"              "Управление прокси (proxy set <url> / proxy on / proxy off / proxy status)"
printf "%-18s %s\n" "RD / RMDIR"         "Удаление папки (rd папка)"
printf "%-18s %s\n" "REN / RENAME"       "Переименование файла (ren старое новое)"
printf "%-18s %s\n" "TREE"               "Вывод дерева папок и файлов (tree / tree linux)"
printf "%-18s %s\n" "TYPE"               "Вывод содержимого текстового файла (type 123.txt)"
printf "%-18s %s\n" "VER"                "Сведения о версии и активной среде"
printf "%-18s %s\n" "WIN-PATH"           "Показать точный путь к файлу в формате Windows"
echo ""
echo "Подсказка: Команды нечувствительны к регистру (DIR, dir, ENV, env работают одинаково)."
echo "Вставка текста в терминал: Ctrl+V, Shift+Insert или Правый клик мыши."
echo ""
