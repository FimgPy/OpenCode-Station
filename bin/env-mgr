#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
OpenCode Station environment manager (portable).

Works on Linux, WSL and macOS without root.  On Windows the GUI/launchers
delegate to WSL, while this CLI can still inspect the manifest if Python is
available.

Made by Anton Kovalkin. All rights reserved.
"""
import os
import shlex
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import station_core as core  # noqa: E402


def _print_env_table():
    data = core.ensure_manifest()
    envs = data.get("environments", {})
    active = core.get_active_env_name()

    print("=" * 112)
    print("                              Список изолированных сред OpenCode")
    print("                              Сделано Антоном Ковалкиным, все права защищены.")
    print("=" * 112)
    if not envs:
        print("  Сред пока нет. Выполните: env create\n")
        return

    print(f"{'Среда':<16} {'Статус':<10} {'Hostname':<24} {'Machine ID':<14} {'Рабочая папка':<34} {'Создана'}")
    print("-" * 112)
    for name, info in envs.items():
        status = "ACTIVE *" if name == active else "IDLE"
        mid = info.get("machine_id", "-")
        mid_short = mid[:10] + "..." if len(mid) > 10 else mid
        ws = info.get("workspace_win") or info.get("workspace", "-")
        created = (info.get("created_at") or "-").split()[0]
        print(f"{name:<16} {status:<10} {info.get('hostname','-'):<24} {mid_short:<14} {ws[:34]:<34} {created}")
    print("-" * 112)
    print(f"Всего сред: {len(envs)}   Активная: {active}")
    print("\nКоманды: env create [имя] | env switch <имя> | env clean [имя] | "
          "env delete <имя> [-w] | env purge | env info\n")


def switch_environment(name, run_cmd=None):
    data = core.ensure_manifest()
    envs = data.get("environments", {})
    if name not in envs:
        print(f"Ошибка: среда '{name}' не найдена. Выполните: env list")
        return False

    info = envs[name]
    mid, hostname = core.ensure_env_identity_files(name, info.get("machine_id"), info.get("hostname"))
    home, workspace = core.env_paths(name)
    os.makedirs(home, exist_ok=True)
    os.makedirs(workspace, exist_ok=True)

    print(f"\n[→] Среда: {name}")
    print(f"    Hostname   : {hostname}")
    print(f"    Machine ID : {mid}")
    print(f"    Платформа  : {core.PLATFORM}")
    print(f"    Папка      : {core.to_display_path(workspace)}")
    print("    (выход из OpenCode: /exit, затем exit)\n")

    data["active"] = name
    core.save_manifest(data)

    bashrc = os.path.join(home, ".bashrc")
    if not os.path.exists(bashrc):
        if name == "default" and core.LEGACY_LAYOUT:
            bashrc = "/home/dev/.bashrc"
        else:
            core._write_env_bashrc(name, home, workspace)
            bashrc = os.path.join(home, ".bashrc")

    bash = shutil.which("bash") or "/bin/bash"
    if not os.path.exists(bash):
        print(f"Ошибка: bash не найден ({bash}). На Windows запускайте через WSL.")
        return False

    env_copy = os.environ.copy()
    env_copy.update({
        "OPENCODE_ENV": name,
        "OPENCODE_STATION_DATA": core.STATE_DIR,
        "HOME": home,
        "OPENCODE_TEST_HOME": home,
        "XDG_DATA_HOME": os.path.join(home, ".local", "share"),
        "XDG_CONFIG_HOME": os.path.join(home, ".config"),
        "XDG_STATE_HOME": os.path.join(home, ".local", "state"),
        "XDG_CACHE_HOME": os.path.join(home, ".cache"),
        "NO_PROXY": core.DEFAULT_NO_PROXY,
        "no_proxy": core.DEFAULT_NO_PROXY,
    })

    enabled, url, _is_global = core.read_proxy_config(home)
    if enabled and url:
        eff = url
        if core.is_socks(url):
            eff = core.start_bridge(name, url)
        ok, err = core.proxy_preflight(url)
        if not ok:
            print(f"[!] Прокси {url} не проходит проверку TLS: {err}")
            print("    Запуск без прокси, чтобы OpenCode не падал с SELF_SIGNED_CERT_IN_CHAIN.")
            enabled = False
        else:
            for key in ("HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy",
                        "ALL_PROXY", "all_proxy"):
                env_copy[key] = eff
    if not enabled:
        for key in ("HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy",
                    "ALL_PROXY", "all_proxy"):
            env_copy.pop(key, None)

    os.chdir(workspace)
    if run_cmd:
        command = f"{run_cmd}; exec {shlex.quote(bash)} --rcfile {shlex.quote(bashrc)} -i"
        os.execvpe(bash, [bash, "--rcfile", bashrc, "-ic", command], env_copy)
    os.execvpe(bash, [bash, "--rcfile", bashrc, "-i"], env_copy)


def clean_environment(name):
    ok, result = core.reset_env(name)
    if not ok:
        print(f"Ошибка: {result}")
        return False
    print(f"[+] Среда {name} очищена. Новый Machine ID: {result['machine_id']}")
    print(f"    Новый Hostname: {result['hostname']}")
    return True


def delete_environment(name, delete_workspace=False):
    ok, msg = core.delete_env(name, delete_workspace)
    print(("[+] " if ok else "[!] ") + msg)
    return ok


def show_info():
    name = core.get_active_env_name()
    info = core.env_info(name)
    home, workspace = core.env_paths(name)
    enabled, url, is_global = core.read_proxy_config(home)
    print("\n" + "=" * 78)
    print(f"                  Паспорт активной среды: [{name}]")
    print("                  Сделано Антоном Ковалкиным, все права защищены.")
    print("=" * 78)
    print(f"  Платформа          : {core.PLATFORM}")
    print(f"  Каталог данных     : {core.STATE_DIR}")
    print(f"  Hostname           : {info.get('hostname', '-')}")
    print(f"  Machine ID         : {info.get('machine_id', '-')}")
    print(f"  Домашний каталог   : {home}")
    print(f"  Рабочая папка      : {workspace}")
    print(f"  Прокси             : {'ВКЛ ' + url if enabled and url else 'ВЫКЛ'}"
          f"{' (глобальный fallback)' if is_global else ''}")
    print(f"  Дата создания      : {info.get('created_at', '-')}")
    print("=" * 78 + "\n")


def main():
    args = sys.argv[1:]
    if not args:
        _print_env_table()
        return 0
    cmd = args[0].lower()
    if cmd in ("list", "ls", "лист", "список"):
        _print_env_table()
    elif cmd in ("create", "new", "add", "создать"):
        name = args[1] if len(args) > 1 else None
        ok, res = core.create_env(name)
        if ok:
            print(f"[+] Среда создана: {res['name']}")
            print(f"    Hostname : {res['hostname']}")
            print(f"    Machine  : {res['machine_id']}")
            print(f"    Папка    : {res['workspace']} ({res['workspace_win']})")
        else:
            print(f"Ошибка: {res}")
            return 1
    elif cmd in ("switch", "use", "enter", "select", "войти", "переключить"):
        if len(args) < 2:
            print('Использование: env switch <имя> [--run "команда"]')
            return 1
        run_cmd = None
        if "--run" in args:
            idx = args.index("--run")
            if idx + 1 < len(args):
                run_cmd = " ".join(args[idx + 1:])
        switch_environment(args[1], run_cmd=run_cmd)
    elif cmd in ("clean", "reset", "сброс", "очистить"):
        name = args[1] if len(args) > 1 else core.get_active_env_name()
        clean_environment(name)
    elif cmd in ("delete", "remove", "rm", "del", "удалить"):
        if len(args) < 2:
            print("Использование: env delete <имя> [-w]")
            return 1
        delete_environment(args[1], "-w" in args or "--with-workspace" in args)
    elif cmd in ("purge", "clear", "clear-all"):
        ok, msg = core.purge_envs()
        print(("[+] " if ok else "[!] ") + msg)
    elif cmd in ("info", "status", "whoami", "инфо"):
        show_info()
    elif cmd in ("help", "--help", "-h", "/?"):
        _print_env_table()
    else:
        print(f"Неизвестная подкоманда '{cmd}'. Доступно: list, create, switch, clean, delete, purge, info")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
