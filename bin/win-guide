#!/usr/bin/env bash
echo -e "\033[1;36m==============================================================================\033[0m"
echo -e "       \033[1;32mКроссплатформенность: Как работать с проектами без проблем\033[0m"
echo -e "\033[1;36m==============================================================================\033[0m"
echo ""
echo -e "Все проекты в папке \033[1;33m~/workspace\033[0m экспортируются на Windows в:"
echo -e "  \033[1;32mD:\\OpenCode-Station_Package\\workspace\033[0m (или C:\\OpenCode-Station_Package\\workspace)"
echo ""
echo -e "\033[1;33m1. Node.js / Web (npm):\033[0m"
echo -e "   - Не копируйте папку \033[1;31mnode_modules\033[0m напрямую между Linux и Windows."
echo -e "     (В Linux скачиваются .so бинарники, а в Windows нужны .dll)."
echo -e "   - На Windows просто откройте папку проекта и введите: \033[1;32mnpm install\033[0m"
echo -e "   - В package.json OpenCode настроен использовать кроссплатформенные утилиты."
echo ""
echo -e "\033[1;33m2. Python:\033[0m"
echo -e "   - Виртуальное окружение (\033[1;31m.venv\033[0m) привязано к конкретной ОС."
echo -e "   - Храните зависимости в \033[1;32mrequirements.txt\033[0m."
echo -e "   - На Windows: \033[1;32mpython -m venv .venv && .venv\\Scripts\\pip install -r requirements.txt\033[0m"
echo ""
echo -e "\033[1;33m3. Переносы строк (CRLF vs LF):\033[0m"
echo -e "   - В рабочей папке включен \033[1;32m.gitattributes\033[0m (LF для исходников, CRLF для .bat)."
echo -e "\033[1;36m==============================================================================\033[0m"