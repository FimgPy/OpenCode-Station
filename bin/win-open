#!/usr/bin/env bash
target="${1:-$(pwd)}"
real=$(readlink -f "$target" 2>/dev/null || realpath "$target" 2>/dev/null || echo "$target")

if [[ "$real" =~ ^/mnt/([a-zA-Z])/(.*) ]]; then
    drive="${BASH_REMATCH[1]^^}"
    rest="${BASH_REMATCH[2]//\//\\}"
    win_path="${drive}:\\${rest}"
elif [[ "$real" == "/mnt/"* ]]; then
    win_path="This PC"
else
    win_path=$(wslpath -w "$real" 2>/dev/null || echo "\\\\wsl.localhost\\Ubuntu${real//\//\\}")
fi

echo -e "\033[1;36m[Открываем проводник Windows]:\033[0m $win_path"
/mnt/c/Windows/explorer.exe "$win_path" 2>/dev/null || true
