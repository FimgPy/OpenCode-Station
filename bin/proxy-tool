#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Portable proxy manager for OpenCode Station.

Every proxy is validated against the real OpenCode endpoints with strict
TLS verification before it can be enabled.  Proxies that MITM TLS are
rejected with a clear explanation instead of breaking OpenCode with
``SELF_SIGNED_CERT_IN_CHAIN``.

Made by Anton Kovalkin. All rights reserved.
"""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import station_core as core  # noqa: E402

GREEN = "\033[1;32m"
CYAN = "\033[1;36m"
YELLOW = "\033[1;33m"
RED = "\033[1;31m"
PURPLE = "\033[1;35m"
GRAY = "\033[0;37m"
RESET = "\033[0m"


def _env():
    name = core.get_active_env_name()
    home, _ = core.env_paths(name)
    return name, home


def _local():
    _, home = _env()
    enabled, url, is_global = core.read_proxy_config(home)
    return {"enabled": enabled, "url": url, "is_global": is_global}


def _validate_or_refuse(url, force=False):
    if not url:
        return True
    print(f"[*] Проверка прокси (IP + строгий TLS opencode.ai): {url}")
    res = core.test_proxy_connectivity(url, timeout=7)
    if res.get("success"):
        print(f"{GREEN}[✓] Прокси пригоден: {res.get('ip')} · {res.get('country')} "
              f"({res.get('city','')}) · {res.get('latency')} ms · TLS OK{RESET}")
        return True
    print(f"{RED}[✗] Прокси отклонён: {res.get('error') or 'недоступен'}{RESET}")
    if res.get("tls_ok") is False:
        print("    Причина: прокси подменяет TLS-сертификат. OpenCode через него")
        print("    падает с ошибкой SELF_SIGNED_CERT_IN_CHAIN. Выберите другой прокси.")
    if force:
        print(f"{YELLOW}[!] --force: сохраняю несмотря на ошибку (OpenCode может не работать).{RESET}")
        return True
    return False


def _set_local(url, enabled=True, force=False):
    name, home = _env()
    url = core.normalize_proxy(url)
    if enabled and not _validate_or_refuse(url, force):
        return False
    core.write_proxy_config(home, url, enabled)
    data = core.ensure_manifest()
    info = data.get("environments", {}).get(name)
    if info is not None:
        info["proxy_url"] = url if enabled else ""
        info["proxy_enabled"] = bool(enabled)
        core.save_manifest(data)
    if enabled and url and not core.is_socks(url):
        core.stop_bridge(name)
    if enabled and url and core.is_socks(url):
        bridge = core.start_bridge(name, url)
        print(f"[i] SOCKS-мост для среды {name}: {bridge}")
    return True


def cmd_status():
    name, home = _env()
    local = _local()
    glob = core.get_global_proxy()
    print("=" * 80)
    print("                     Статус прокси OpenCode Station")
    print("                Сделано Антоном Ковалкиным, все права защищены.")
    print("=" * 80)
    print(f"\n{PURPLE}[Глобальный fallback]{RESET}")
    if glob.get("enabled") and glob.get("url"):
        print(f"  Статус: {GREEN}ВКЛЮЧЕН{RESET}  URL: {CYAN}{glob['url']}{RESET}")
        print("  (применяется только к средам без собственного .proxy_config)")
    else:
        print(f"  Статус: {GRAY}ВЫКЛЮЧЕН{RESET}")
    print(f"\n{CYAN}[Текущая среда: {name}]{RESET}")
    if local.get("enabled") and local.get("url"):
        print(f"  Статус: {GREEN}ВКЛЮЧЕН{RESET}  URL: {CYAN}{local['url']}{RESET}")
    else:
        print(f"  Статус: {GRAY}ВЫКЛЮЧЕН (прямое подключение){RESET}")
        if local.get("url"):
            print(f"  Сохранённый URL: {local['url']}")
    print("\n" + "-" * 80)
    print("  proxy list                 — каталог проверенных прокси")
    print("  proxy select <N>           — выбрать прокси для текущей среды")
    print("  proxy set <url> [--force]  — задать и проверить прокси")
    print("  proxy on / off             — включить / выключить прокси среды")
    print("  proxy global status|on|off — глобальный fallback")
    print("  proxy test <N|url>         — IP + строгий TLS тест")
    print("=" * 80)


def cmd_list():
    catalog = core.get_proxies_catalog()
    if not catalog:
        print(f"{YELLOW}Каталог пуст. Выполните: proxy refresh{RESET}")
        return
    _, home = _env()
    enabled, local_url, _ = core.read_proxy_config(home)
    print("=" * 112)
    print("                    Каталог проверенных рабочих прокси (Европа)")
    print("                    Сделано Антоном Ковалкиным, все права защищены.")
    print("=" * 112)
    print(f"{'#':<4} {'Страна / город':<30} {'Тип':<6} {'Пинг':<9} {'TLS':<5} URL")
    print("-" * 112)
    for idx, item in enumerate(catalog, 1):
        country = item.get("country", "Неизвестно")
        city = item.get("city", "")
        loc = f"{country} ({city})" if city else country
        tls = "OK" if item.get("tls_ok", item.get("working", False)) else "BAD"
        mark = f" {CYAN}[ENV]{RESET}" if enabled and item.get("url") == local_url else ""
        lat = item.get("latency", 0)
        color = GREEN if lat and lat < 1200 else (YELLOW if lat and lat < 2500 else GRAY)
        print(f"{idx:<4} {loc[:30]:<30} {item.get('type','HTTP'):<6} "
              f"{color}{lat} ms{RESET:<4} {tls:<5} {CYAN}{item.get('url','')}{RESET}{mark}")
    print("-" * 112)
    print("  proxy select <N>  — применить к текущей среде    proxy test <N> — проверить")
    print("=" * 112)


def cmd_select(number, is_global=False):
    catalog = core.get_proxies_catalog()
    try:
        item = catalog[int(number) - 1]
    except Exception:
        print(f"{RED}Неверный номер. Доступно 1..{len(catalog)}.{RESET}")
        return False
    url = item.get("url", "")
    if is_global:
        if not _validate_or_refuse(url):
            return False
        cfg = core.set_global_proxy(url, enabled=True, apply_to_all_envs=False)
        print(f"{GREEN}[✓] Глобальный fallback: {cfg['url']}{RESET}")
    else:
        if not _set_local(url, True):
            return False
        print(f"{GREEN}[✓] Прокси среды: {url}{RESET}")
    subprocess.run([sys.executable, os.path.join(core.BIN_DIR, "myip")])
    return True


def cmd_test(target):
    if target.isdigit():
        catalog = core.get_proxies_catalog()
        idx = int(target) - 1
        if not (0 <= idx < len(catalog)):
            print(f"{RED}Неверный номер прокси.{RESET}")
            return
        target = catalog[idx].get("url", "")
    if not target:
        target = _local().get("url") or core.get_global_proxy().get("url", "")
    if not target:
        print("Укажите номер или URL: proxy test <N|http://host:port>")
        return
    res = core.test_proxy_connectivity(target, timeout=8)
    if res.get("success"):
        print(f"{GREEN}[✓] Прокси работает{RESET}")
        print(f"    IP: {res.get('ip')} | {res.get('country')} ({res.get('city','')})")
        print(f"    Организация: {res.get('org','-')} | Задержка: {res.get('latency')} ms")
        print(f"    TLS: OK (сертификат opencode.ai проверен)")
    else:
        print(f"{RED}[✗] Прокси не прошёл проверку{RESET}")
        print(f"    {res.get('error')}")
        for chk in res.get("checks", []):
            print(f"    {chk.get('name')}: HTTP {chk.get('http')} rc={chk.get('rc')} {chk.get('error','')}")


def cmd_refresh():
    catalog = core.get_proxies_catalog()
    if not catalog:
        print("Каталог пуст — нечего проверять.")
        return
    print(f"[*] Проверяю {len(catalog)} прокси (IP + строгий TLS)...")
    import concurrent.futures
    updated = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as ex:
        futs = {ex.submit(core.test_proxy_connectivity, p.get("url", ""), 8): p for p in catalog}
        for fut in concurrent.futures.as_completed(futs):
            old = dict(futs[fut])
            try:
                res = fut.result()
            except Exception as exc:
                res = {"success": False, "error": str(exc)}
            if res.get("success"):
                old.update({
                    "ip": res.get("ip", old.get("ip", "")),
                    "country": res.get("country", old.get("country", "")),
                    "country_code": res.get("country_code", old.get("country_code", "")),
                    "city": res.get("city", old.get("city", "")),
                    "org": res.get("org", old.get("org", "")),
                    "latency": res.get("latency", old.get("latency", 999)),
                    "type": res.get("type", old.get("type", "HTTP")),
                    "tls_ok": True,
                    "working": True,
                    "error": "",
                })
                print(f"  [OK] {old.get('url')} {old.get('ip')} {old.get('country')} {old.get('latency')}ms")
            else:
                old.update({"working": False, "tls_ok": False,
                            "error": res.get("error", "unreachable")})
                print(f"  [--] {old.get('url')} {res.get('error', '')}")
            updated.append(old)
    updated.sort(key=lambda x: (not x.get("working"), x.get("latency", 9999)))
    core.save_proxies_catalog(updated)
    print(f"[+] Готово: рабочих {sum(1 for x in updated if x.get('working'))} из {len(updated)}")


def cmd_global(args):
    sub = args[0].lower() if args else "status"
    g = core.get_global_proxy()
    if sub in ("status", ""):
        print(f"Глобальный fallback: {'ВКЛЮЧЕН' if g.get('enabled') else 'ВЫКЛЮЧЕН'}")
        print(f"URL: {g.get('url') or 'не задан'}")
    elif sub == "on":
        if not g.get("url"):
            print("Сначала: proxy global set <url>")
            return
        if not _validate_or_refuse(g["url"]):
            return
        core.set_global_proxy(g["url"], enabled=True, apply_to_all_envs=False)
        print(f"{GREEN}[✓] Глобальный fallback включён{RESET}")
    elif sub == "off":
        core.set_global_proxy(g.get("url", ""), enabled=False, apply_to_all_envs=False)
        print(f"{YELLOW}[✓] Глобальный fallback выключен{RESET}")
    elif sub == "set":
        if len(args) < 2:
            print("Использование: proxy global set <url> [--all]")
            return
        url = args[1]
        if not _validate_or_refuse(url):
            return
        apply_all = "--all" in args
        core.set_global_proxy(url, enabled=True, apply_to_all_envs=apply_all)
        print(f"{GREEN}[✓] Глобальный fallback: {url}{RESET}"
              f"{' (применён ко всем средам)' if apply_all else ''}")
    elif sub == "select":
        if len(args) < 2:
            print("Использование: proxy global select <N>")
            return
        cmd_select(args[1], is_global=True)
    else:
        print("Использование: proxy global {set <url> [--all] | on | off | status | select <N>}")


def main():
    args = sys.argv[1:]
    if not args or args[0].lower() in ("status", "info"):
        cmd_status()
        return 0
    cmd = args[0].lower()
    if cmd == "list":
        cmd_list()
    elif cmd == "select":
        if len(args) < 2:
            print("Использование: proxy select [--global] <номер>")
            return 1
        if args[1] == "--global" and len(args) >= 3:
            cmd_select(args[2], is_global=True)
        elif len(args) >= 3 and args[2] == "--global":
            cmd_select(args[1], is_global=True)
        else:
            cmd_select(args[1], is_global=False)
    elif cmd == "test":
        cmd_test(args[1] if len(args) > 1 else "")
    elif cmd == "set":
        if len(args) < 2:
            print("Использование: proxy set <url> [--force]")
            return 1
        if _set_local(args[1], enabled=True, force="--force" in args):
            print(f"{GREEN}[✓] Прокси установлен для среды {_env()[0]}{RESET}")
            subprocess.run([sys.executable, os.path.join(core.BIN_DIR, "myip")])
    elif cmd == "on":
        loc = _local()
        if not loc.get("url"):
            print("Адрес не задан. Используйте: proxy set <url> или proxy select <N>")
            return 1
        if _set_local(loc["url"], enabled=True):
            print(f"{GREEN}[✓] Прокси включён: {loc['url']}{RESET}")
            subprocess.run([sys.executable, os.path.join(core.BIN_DIR, "myip")])
    elif cmd == "off":
        loc = _local()
        _set_local(loc.get("url", ""), enabled=False)
        print(f"{YELLOW}[✓] Прокси выключен для среды {_env()[0]}{RESET}")
    elif cmd == "global":
        cmd_global(args[1:])
    elif cmd in ("refresh", "test-all"):
        cmd_refresh()
    elif cmd in ("clean", "clear"):
        core.save_proxies_catalog([])
        print("[✓] Каталог прокси очищен.")
    else:
        print("Использование: proxy {list|select|status|set|on|off|global|test|refresh|clean}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
