#!/usr/bin/env bash
# Network Proxy Management Utility
# Сделано Антоном Ковалкиным все права защищены.

CONFIG_FILE="$HOME/.proxy_config"
CURLRC="$HOME/.curlrc"
DEFAULT_NO_PROXY="localhost,127.0.0.1,::1,local.home"

ensure_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        cat << 'EOF' > "$CONFIG_FILE"
PROXY_ENABLED="no"
PROXY_URL=""
EOF
    fi
    source "$CONFIG_FILE" 2>/dev/null || true
}

apply_proxy() {
    local url="$1"
    echo 'PROXY_ENABLED="yes"' > "$CONFIG_FILE"
    echo "PROXY_URL=\"$url\"" >> "$CONFIG_FILE"
    
    echo "proxy = \"$url\"" > "$CURLRC"
    export http_proxy="$url"
    export https_proxy="$url"
    export all_proxy="$url"
    export HTTP_PROXY="$url"
    export HTTPS_PROXY="$url"
    export ALL_PROXY="$url"
    export no_proxy="$DEFAULT_NO_PROXY"
    export NO_PROXY="$DEFAULT_NO_PROXY"
    
    echo -e "\033[1;32m[✓] Прокси активирован:\033[0m $url"
    echo -e "\033[0;37mИсключения (local loopback):\033[0m $DEFAULT_NO_PROXY"
    /usr/local/bin/myip
}

case "$1" in
    on|ON)
        ensure_config
        if [ -z "$PROXY_URL" ]; then
            echo "Адрес прокси не задан. Задайте прокси командой:"
            echo "  proxy set <http://хост:порт или socks5://хост:порт>"
            exit 1
        fi
        apply_proxy "$PROXY_URL"
        ;;
    off|OFF)
        ensure_config
        echo 'PROXY_ENABLED="no"' > "$CONFIG_FILE"
        echo "PROXY_URL=\"$PROXY_URL\"" >> "$CONFIG_FILE"
        rm -f "$CURLRC" 2>/dev/null || true
        unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY no_proxy NO_PROXY
        echo -e "\033[1;33m[✓] Прокси отключен.\033[0m Прямое интернет-подключение."
        /usr/local/bin/myip
        ;;
    set|SET)
        if [ -z "$2" ]; then
            echo "Использование: proxy set <url>"
            echo "Примеры:"
            echo "  proxy set http://127.0.0.1:10808"
            echo "  proxy set socks5://127.0.0.1:7890"
            echo "  proxy set socks5://user:pass@host:port"
            exit 1
        fi
        apply_proxy "$2"
        ;;
    status|STATUS|"")
        ensure_config
        echo "=================================================="
        echo "           Статус прокси в консоли                "
        echo "=================================================="
        if [ "$PROXY_ENABLED" = "yes" ] || [ -n "$http_proxy" ]; then
            echo "Статус:           АКТИВЕН"
            echo "Адрес:            ${PROXY_URL:-$http_proxy}"
            echo "Исключения:       $DEFAULT_NO_PROXY"
        else
            echo "Статус:           ОТКЛЮЧЕН (Прямое подключение)"
        fi
        echo "Сохраненный URL:  ${PROXY_URL:-не задан}"
        echo "--------------------------------------------------"
        echo "Команды:"
        echo "  proxy set <url>   -> Установить адрес прокси"
        echo "  proxy on          -> Включить прокси"
        echo "  proxy off         -> Отключить прокси"
        echo "  proxy status      -> Показать статус"
        echo "  myip              -> Проверить текущий внешний IP"
        echo "=================================================="
        ;;
    *)
        echo "Использование: proxy {set <url> | on | off | status}"
        exit 1
        ;;
esac
