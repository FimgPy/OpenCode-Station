    try:
        model_data = {
            "recent": [{"providerID": "opencode", "modelID": "deepseek-v4.1-flash-free"}],
            "favorite": [{"providerID": "opencode", "modelID": "deepseek-v4.1-flash-free"}],
            "variant": {"opencode/deepseek-v4.1-flash-free": "max"}
        }
        upsell_data = {
            "lastSeenAt": 1792847625488,
            "dontShow": True
        }
        opencode_json = {
            "$schema": "https://opencode.ai/config.json",
            "model": "opencode/deepseek-v4.1-flash-free",
            "providers": {
                "opencode": {
                    "models": {
                        "deepseek-v4.1-flash-free": {
                            "limit": {
                                "context": 1000000,
                                "output": 32000
                            }
                        }
                    }
                }
            }
        }
        tui_dir = os.path.join(home_dir, ".local", "state", "opencode", "latest", "tui")
        os.makedirs(tui_dir, exist_ok=True)
        with open(os.path.join(tui_dir, "go-upsell.json"), "w", encoding="utf-8") as f:
