        state_dir = os.path.join(home_dir, ".local", "state", "opencode")
        os.makedirs(state_dir, exist_ok=True)
        with open(os.path.join(state_dir, "model.json"), "w", encoding="utf-8") as f:
            json.dump(model_data, f, indent=2)

