#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
OpenCode Station GUI / REST API v3.0 (portable).

Runs on Linux, WSL and macOS.  On Windows the launchers execute this server
inside WSL; the module itself has no hard-coded /var/envs, /mnt/d or
/usr/local paths.

Made by Anton Kovalkin. All rights reserved.
"""
import argparse
import base64
import concurrent.futures
import datetime
import io
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.parse
import zipfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import station_core as core  # noqa: E402

PORT = int(os.environ.get("OPENCODE_STATION_PORT", "7682"))
HOST = os.environ.get("OPENCODE_STATION_HOST", "0.0.0.0")
TERMINAL_PORT = int(os.environ.get("OPENCODE_STATION_TERMINAL_PORT", "7681"))
APP_HTML = os.path.join(core.STATION_ROOT, "terminal.html")
APP_HTML_FALLBACKS = [
    "/usr/local/share/opencode_gui/index.html",
    "/usr/local/terminal.html",
]

_MANIFEST_LOCK = threading.RLock()
_IP_CACHE = {}
_IP_CACHE_TTL = 30.0
_TERMINAL_STARTED = False


# ---------------------------------------------------------------------------
# Status helpers
# ---------------------------------------------------------------------------

def _cached_ip(env_name, force=False):
    now = time.time()
    cached = _IP_CACHE.get(env_name)
    if cached and not force and now - cached["time"] < _IP_CACHE_TTL:
        return cached["data"]
    data = core.check_env_ip(env_name)
    _IP_CACHE[env_name] = {"data": data, "time": now}
    return data


def _placeholder_ip(env_name):
    cached = _IP_CACHE.get(env_name)
    if cached:
        return cached["data"]
    home, _ = core.env_paths(env_name)
    enabled, url, is_global = core.read_proxy_config(home)
    return {
        "status": "success",
        "query": "Нажмите «Проверить IP»",
        "country": "Определение по клику",
        "city": "",
        "org": "",
        "proxy_active": enabled and bool(url),
        "proxy_url": url,
        "is_global": is_global,
        "env": env_name,
    }


def _terminal_payload():
    st = core.ttyd_status()
    running = bool(st.get("running"))
    return {
        "running": running,
        "url": f"http://localhost:{st.get('port', TERMINAL_PORT)}/?t={int(time.time())}" if running else "",
        "port": st.get("port", TERMINAL_PORT),
        "env": st.get("env", ""),
        "session": st.get("session", ""),
        "available": bool(core.find_ttyd()),
    }


def build_status():
    manifest = core.ensure_manifest()
    active = manifest.get("active", "default")
    envs = manifest.get("environments", {})
    for name, info in envs.items():
        ws = info.get("workspace", "")
        try:
            info["files_count"] = len(os.listdir(ws)) if os.path.isdir(ws) else 0
        except Exception:
            info["files_count"] = 0
        sessions = core.get_env_sessions(info.get("home", ""))
        info["sessions"] = sessions
        info["latest_session"] = sessions[0] if sessions else None
        info["display_path"] = core.to_display_path(ws)
    return {
        "status": "ok",
        "app": core.APP_NAME,
        "version": core.APP_VERSION,
        "platform": core.PLATFORM,
        "state_dir": core.STATE_DIR,
        "environments": envs,
        "active_env": active,
        "network": _placeholder_ip(active),
        "terminal": _terminal_payload(),
        "ttyd_available": bool(core.find_ttyd()),
        "win_projects_dir": core.export_root() or os.path.join(core.STATION_ROOT, "workspace"),
        "win_projects_path": core.to_display_path(core.export_root() or os.path.join(core.STATION_ROOT, "workspace")),
    }


# ---------------------------------------------------------------------------
# HTTP handler
# ---------------------------------------------------------------------------

class GUIRequestHandler(BaseHTTPRequestHandler):
    server_version = "OpenCodeStation/" + core.APP_VERSION

    def log_message(self, fmt, *args):
        # Keep the console readable; errors are still visible.
        if args and str(args[1] if len(args) > 1 else "").startswith(("4", "5")):
            sys.stderr.write("[gui] " + (fmt % args) + "\n")

    def send_json(self, data, status=200):
        raw = json.dumps(data, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS, DELETE")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def send_bytes(self, data, content_type, filename=None, status=200):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        if filename:
            self.send_header("Content-Disposition", f'attachment; filename="{filename}"')
        self.end_headers()
        self.wfile.write(data)

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS, DELETE")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    # ------------------------------------------------------------ GET
    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)

        if path in ("/api/ping", "/api/health"):
            self.send_json({"status": "ok", "app": core.APP_NAME,
                            "version": core.APP_VERSION, "platform": core.PLATFORM,
                            "time": time.time()})
            return

        if path == "/api/status":
            self.send_json(build_status())
            return

        if path == "/api/envs":
            manifest = core.ensure_manifest()
            envs = manifest.get("environments", {})
            for name, info in envs.items():
                info["sessions"] = core.get_env_sessions(info.get("home", ""))
                info["latest_session"] = info["sessions"][0] if info["sessions"] else None
                info["display_path"] = core.to_display_path(info.get("workspace", ""))
            self.send_json({"environments": envs, "active": manifest.get("active", "default")})
            return

        if path == "/api/sessions":
            env_name = query.get("env", [core.get_active_env_name()])[0]
            home, _ = core.env_paths(env_name)
            self.send_json({"env": env_name, "sessions": core.get_env_sessions(home)})
            return

        if path == "/api/proxy":
            env_name = query.get("env", [core.get_active_env_name()])[0]
            info = core.env_info(env_name)
            force = query.get("force", ["1"])[0] not in ("0", "false", "no")
            self.send_json({
                "env": env_name,
                "proxy_url": info.get("proxy_url", ""),
                "proxy_enabled": info.get("proxy_enabled", False),
                "global_proxy": core.get_global_proxy(),
                "ip_check": _cached_ip(env_name, force=force),
            })
            return

        if path == "/api/proxy/global":
            self.send_json({"success": True, "global_proxy": core.get_global_proxy()})
            return

        if path == "/api/proxies/catalog":
            self.send_json({"success": True, "proxies": core.get_proxies_catalog(),
                            "global_proxy": core.get_global_proxy()})
            return

        if path == "/api/terminal/status":
            self.send_json({"success": True, "terminal": _terminal_payload()})
            return

        if path == "/api/provider":
            self.send_json(core.load_provider_config())
            return

        if path == "/api/myip":
            env_name = query.get("env", [core.get_active_env_name()])[0]
            self.send_json(_cached_ip(env_name, force=True))
            return

        if path == "/api/files":
            manifest = core.ensure_manifest()
            active = manifest.get("active", "default")
            info = manifest.get("environments", {}).get(active, {})
            default_target = info.get("workspace") or core.default_env_workspace()
            target = query.get("path", [default_target])[0] or default_target
            target = core.to_native_path(target)
            parent = os.path.dirname(os.path.abspath(target))
            self.send_json({
                "current_path": target,
                "current_win_path": core.to_display_path(target),
                "parent_path": parent if parent != target else os.path.dirname(target),
                "items": core.get_dir_contents(target),
            })
            return

        if path == "/api/file/read":
            target = core.to_native_path(query.get("path", [""])[0])
            if not target or not os.path.exists(target):
                self.send_json({"error": "Файл не найден"}, status=404)
                return
            if os.path.isdir(target):
                self.send_json({"error": "Это папка, а не файл"}, status=400)
                return
            try:
                with open(target, "r", encoding="utf-8", errors="replace") as fh:
                    content = fh.read(1_000_000)
                self.send_json({"path": target, "win_path": core.to_display_path(target),
                                "name": os.path.basename(target),
                                "size": os.path.getsize(target), "content": content})
            except Exception as exc:
                self.send_json({"error": str(exc)}, status=500)
            return

        if path == "/api/file/download":
            target = core.to_native_path(query.get("path", [""])[0])
            if not target or not os.path.isfile(target):
                self.send_response(404)
                self.end_headers()
                return
            try:
                with open(target, "rb") as fh:
                    data = fh.read()
                self.send_bytes(data, "application/octet-stream", os.path.basename(target))
            except Exception as exc:
                self.send_json({"error": str(exc)}, status=500)
            return

        if path == "/api/files/zip":
            target_dir = core.to_native_path(query.get("dir", [""])[0] or core.default_env_workspace())
            items_param = query.get("items", [""])[0]
            bio = io.BytesIO()
            with zipfile.ZipFile(bio, "w", zipfile.ZIP_DEFLATED) as zf:
                if items_param:
                    for iname in [x.strip() for x in items_param.split(";") if x.strip()]:
                        full = os.path.join(target_dir, iname)
                        if os.path.isdir(full):
                            for root, _dirs, files in os.walk(full):
                                for fname in files:
                                    fp = os.path.join(root, fname)
                                    zf.write(fp, os.path.relpath(fp, target_dir))
                        elif os.path.isfile(full):
                            zf.write(full, iname)
                elif os.path.isdir(target_dir):
                    for root, _dirs, files in os.walk(target_dir):
                        for fname in files:
                            fp = os.path.join(root, fname)
                            zf.write(fp, os.path.relpath(fp, target_dir))
            self.send_bytes(bio.getvalue(), "application/zip", "opencode_export.zip")
            return

        if path in ("/", "/index.html"):
            self.serve_app()
            return

        if path == "/favicon.ico":
            self.send_bytes(b"", "image/x-icon", status=204)
            return

        self.send_response(404)
        self.end_headers()

    # ------------------------------------------------------------ POST
    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        length = int(self.headers.get("Content-Length", 0) or 0)
        body = self.rfile.read(length) if length else b"{}"
        try:
            req = json.loads(body.decode("utf-8")) if body else {}
        except Exception:
            req = {}

        try:
            if path == "/api/opencode/kill":
                env_name = (req.get("env") or "").strip()
                if env_name:
                    n = core.kill_env_processes(env_name)
                else:
                    n = 0
                    for name in core.ensure_manifest().get("environments", {}):
                        n += core.kill_env_processes(name)
                self.send_json({"success": True, "killed": n,
                                "message": "Процессы OpenCode остановлены"})
                return

            if path == "/api/terminal/launch":
                env_name = (req.get("env") or core.get_active_env_name()).strip()
                session = (req.get("session") or "").strip() or None
                run_opencode = bool(req.get("run_opencode", True))
                ok, result = core.start_terminal(env_name, session, TERMINAL_PORT,
                                                 run_opencode=run_opencode)
                if ok:
                    self.send_json({"success": True, "terminal": result})
                else:
                    self.send_json({"success": False, "error": result}, status=500)
                return

            if path == "/api/terminal/reset":
                env_name = (req.get("env") or core.get_active_env_name()).strip()
                ok, result = core.start_terminal(env_name, None, TERMINAL_PORT,
                                                 run_opencode=False)
                if ok:
                    self.send_json({"success": True, "terminal": result})
                else:
                    self.send_json({"success": False, "error": result}, status=500)
                return

            if path == "/api/terminal/stop":
                core.stop_terminal()
                self.send_json({"success": True})
                return

            if path == "/api/envs/create":
                name = (req.get("name") or "").strip()
                with _MANIFEST_LOCK:
                    ok, result = core.create_env(name)
                if ok:
                    self.send_json({"success": True, "env": result})
                else:
                    self.send_json({"success": False, "error": result}, status=400)
                return

            if path == "/api/envs/reset":
                name = (req.get("name") or "").strip()
                if _terminal_payload().get("env") == name:
                    core.stop_terminal()
                ok, result = core.reset_env(name)
                if ok:
                    self.send_json({"success": True, "result": result})
                else:
                    self.send_json({"success": False, "error": result}, status=400)
                return

            if path == "/api/envs/delete":
                name = (req.get("name") or "").strip()
                if _terminal_payload().get("env") == name:
                    core.stop_terminal()
                with _MANIFEST_LOCK:
                    ok, result = core.delete_env(name, bool(req.get("delete_workspace", False)))
                if ok:
                    self.send_json({"success": True, "result": result})
                else:
                    self.send_json({"success": False, "error": result}, status=400)
                return

            if path == "/api/envs/purge":
                with _MANIFEST_LOCK:
                    ok, result = core.purge_envs()
                self.send_json({"success": ok, "result": result})
                return

            if path in ("/api/envs/set_active", "/api/envs/switch"):
                name = (req.get("name") or "").strip()
                ok, result = core.set_active_env(name)
                if ok:
                    self.send_json({"success": True, "result": result})
                else:
                    self.send_json({"success": False, "error": result}, status=400)
                return

            if path == "/api/proxy/set":
                self.handle_proxy_set(req)
                return

            if path == "/api/proxy/toggle":
                req["enable"] = bool(req.get("enable", False))
                self.handle_proxy_set(req, toggle_only=True)
                return

            if path == "/api/proxy/global":
                url = (req.get("url") or "").strip()
                enable = bool(req.get("enable", True))
                apply_all = bool(req.get("apply_all", False))
                if enable and url:
                    check = core.test_proxy_connectivity(url, timeout=8)
                    if not check.get("success"):
                        self.send_json({"success": False,
                                        "error": check.get("error", "Прокси недоступен"),
                                        "tls_ok": check.get("tls_ok", False)}, status=400)
                        return
                cfg = core.set_global_proxy(url, enable, apply_to_all_envs=apply_all)
                self.send_json({"success": True, "global_proxy": cfg})
                return

            if path == "/api/proxies/catalog/test":
                url = (req.get("url") or "").strip()
                self.send_json(core.test_proxy_connectivity(url, timeout=8))
                return

            if path == "/api/proxies/catalog/refresh":
                self.handle_catalog_refresh()
                return

            if path == "/api/provider/save":
                pcfg = {
                    "provider": req.get("provider", "opencode"),
                    "model": req.get("model", ""),
                    "apiKey": (req.get("apiKey") or "").strip(),
                    "updated_at": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                }
                core.save_provider_config(pcfg)
                manifest = core.ensure_manifest()
                if req.get("apply_all", True):
                    for ename, einfo in manifest.get("environments", {}).items():
                        core.apply_provider_to_env(ename, einfo, pcfg)
                else:
                    active = manifest.get("active", "default")
                    if active in manifest.get("environments", {}):
                        core.apply_provider_to_env(active, manifest["environments"][active], pcfg)
                self.send_json({"success": True, "config": pcfg})
                return

            if path == "/api/provider/test":
                ok, msg = core.test_provider_api(
                    req.get("provider", "opencode"),
                    (req.get("apiKey") or "").strip(),
                    req.get("model", ""),
                    env_name=req.get("env"),
                )
                self.send_json({"success": ok, "message": msg})
                return

            if path == "/api/export":
                self.handle_export(req)
                return

            if path == "/api/import":
                self.handle_import(req)
                return

            if path == "/api/files/upload":
                dest = core.to_native_path(req.get("dir", "")) or core.default_env_workspace()
                filename = os.path.basename(req.get("name", "uploaded_file")) or "uploaded_file"
                b64 = req.get("content_base64", "")
                if not b64:
                    self.send_json({"error": "Пустое содержимое"}, status=400)
                    return
                os.makedirs(dest, exist_ok=True)
                target = os.path.join(dest, filename)
                with open(target, "wb") as fh:
                    fh.write(base64.b64decode(b64))
                self.send_json({"success": True, "path": target,
                                "win_path": core.to_display_path(target)})
                return

            if path == "/api/files/write":
                target = core.to_native_path(req.get("path", ""))
                if not target:
                    self.send_json({"error": "Путь не указан"}, status=400)
                    return
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with open(target, "w", encoding="utf-8") as fh:
                    fh.write(req.get("content", ""))
                self.send_json({"success": True})
                return

            if path == "/api/files/copy":
                src = core.to_native_path(req.get("src", ""))
                dst = core.to_native_path(req.get("dst", ""))
                if not src or not dst or not os.path.exists(src):
                    self.send_json({"error": "Исходный файл или папка не существует"}, status=400)
                    return
                if os.path.isdir(src):
                    target = os.path.join(dst, os.path.basename(src.rstrip("/\\")))
                    shutil.rmtree(target, ignore_errors=True)
                    shutil.copytree(src, target)
                else:
                    os.makedirs(dst, exist_ok=True)
                    shutil.copy2(src, dst)
                self.send_json({"success": True})
                return

            if path == "/api/files/delete":
                target = core.to_native_path(req.get("path", ""))
                if not target or not os.path.exists(target):
                    self.send_json({"error": "Файл не найден"}, status=404)
                    return
                if os.path.isdir(target):
                    shutil.rmtree(target, ignore_errors=True)
                else:
                    os.remove(target)
                self.send_json({"success": True})
                return

            if path == "/api/files/delete_batch":
                deleted = 0
                for item in req.get("paths", []):
                    target = core.to_native_path(item)
                    if target and os.path.exists(target):
                        if os.path.isdir(target):
                            shutil.rmtree(target, ignore_errors=True)
                        else:
                            os.remove(target)
                        deleted += 1
                self.send_json({"success": True, "deleted_count": deleted})
                return

            if path == "/api/files/mkdir":
                target = core.to_native_path(req.get("path", ""))
                if not target:
                    self.send_json({"error": "Путь не указан"}, status=400)
                    return
                os.makedirs(target, exist_ok=True)
                self.send_json({"success": True})
                return

            if path == "/api/open_explorer":
                target = core.to_native_path(req.get("path", "")) or core.export_root() or core.STATION_ROOT
                self.send_json(self.open_in_file_manager(target))
                return

            self.send_response(404)
            self.end_headers()
        except Exception as exc:
            self.send_json({"success": False, "error": str(exc)}, status=500)

    # ------------------------------------------------------------ operations
    def handle_proxy_set(self, req, toggle_only=False):
        env_name = (req.get("env") or core.get_active_env_name()).strip()
        manifest = core.ensure_manifest()
        envs = manifest.get("environments", {})
        if env_name not in envs:
            self.send_json({"error": f"Среда '{env_name}' не найдена"}, status=404)
            return

        info = envs[env_name]
        if toggle_only:
            url = info.get("proxy_url", "")
            enable = bool(req.get("enable", False))
        else:
            url = (req.get("url") or "").strip()
            enable = bool(req.get("enable", True))
        url = core.normalize_proxy(url)

        if enable and url:
            check = core.test_proxy_connectivity(url, timeout=8)
            if not check.get("success"):
                # Save the URL but keep the proxy disabled: this is safer than
                # launching OpenCode into a TLS-intercepting proxy.
                info["proxy_url"] = url
                info["proxy_enabled"] = False
                core.save_manifest(manifest)
                core.write_proxy_config(info.get("home", ""), url, False)
                _IP_CACHE.pop(env_name, None)
                self.send_json({
                    "success": False,
                    "error": check.get("error", "Прокси не прошёл проверку"),
                    "tls_ok": check.get("tls_ok", False),
                    "ip_check": check,
                }, status=400)
                return

        info["proxy_url"] = url
        info["proxy_enabled"] = enable
        core.save_manifest(manifest)
        core.write_proxy_config(info.get("home", ""), url, enable)
        _IP_CACHE.pop(env_name, None)
        if enable and url and core.is_socks(url):
            core.start_bridge(env_name, url)
        else:
            core.stop_bridge(env_name)
        if req.get("make_global") and url:
            core.set_global_proxy(url, enable, apply_to_all_envs=False)
        ip_res = _cached_ip(env_name, force=True)
        self.send_json({"success": True, "env": env_name, "ip_check": ip_res})

    def handle_catalog_refresh(self):
        catalog = core.get_proxies_catalog()
        if not catalog:
            self.send_json({"success": True, "proxies": []})
            return
        results = []
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
            futs = {ex.submit(core.test_proxy_connectivity, p.get("url", ""), 8): dict(p)
                    for p in catalog}
            for fut in concurrent.futures.as_completed(futs):
                old = futs[fut]
                try:
                    res = fut.result()
                except Exception as exc:
                    res = {"success": False, "error": str(exc)}
                if res.get("success"):
                    old.update({
                        "ip": res.get("ip", old.get("ip", "")),
                        "country": res.get("country", old.get("country", "")),
                        "country_code": res.get("country_code", old.get("country_code", "")),
                        "city": res.get("city", old.get("city", "")),
                        "org": res.get("org", old.get("org", "")),
                        "latency": res.get("latency", old.get("latency", 999)),
                        "type": res.get("type", old.get("type", "HTTP")),
                        "tls_ok": True, "working": True, "error": "",
                    })
                    results.append(old)
        results.sort(key=lambda x: (not x.get("working"), x.get("latency", 9999)))
        core.save_proxies_catalog(results)
        self.send_json({"success": True, "proxies": results})

    def handle_export(self, req):
        src_paths = req.get("paths", [])
        src_dir = core.to_native_path(req.get("src_dir", "")) or core.default_env_workspace()
        dest_win = req.get("dest_win") or core.export_root()
        if not dest_win:
            self.send_json({"error": "Экспорт в Windows доступен только в WSL/Windows"}, status=400)
            return
        dest = core.to_native_path(dest_win)
        os.makedirs(dest, exist_ok=True)
        copied = []
        if src_paths:
            for item in src_paths:
                src = core.to_native_path(item)
                if not os.path.exists(src):
                    continue
                base = os.path.basename(src.rstrip("/\\"))
                target = os.path.join(dest, base)
                if os.path.isdir(src):
                    shutil.rmtree(target, ignore_errors=True)
                    shutil.copytree(src, target)
                else:
                    shutil.copy2(src, target)
                copied.append(base)
        elif os.path.isdir(src_dir):
            for entry in os.scandir(src_dir):
                if entry.name.startswith("."):
                    continue
                target = os.path.join(dest, entry.name)
                if entry.is_dir():
                    shutil.rmtree(target, ignore_errors=True)
                    shutil.copytree(entry.path, target)
                else:
                    shutil.copy2(entry.path, target)
                copied.append(entry.name)
        self.send_json({"success": True, "copied": copied, "count": len(copied),
                        "dest_win": dest_win})

    def handle_import(self, req):
        src_win = req.get("src_win") or core.export_root()
        dest = core.to_native_path(req.get("dest_linux", "")) or core.default_env_workspace()
        if not src_win:
            self.send_json({"error": "Импорт из Windows доступен только в WSL/Windows"}, status=400)
            return
        src = core.to_native_path(src_win)
        if not os.path.isdir(src):
            self.send_json({"error": f"Папка {src_win} не найдена"}, status=404)
            return
        os.makedirs(dest, exist_ok=True)
        imported = []
        for entry in os.scandir(src):
            if entry.name.startswith("."):
                continue
            target = os.path.join(dest, entry.name)
            if entry.is_dir():
                shutil.rmtree(target, ignore_errors=True)
                shutil.copytree(entry.path, target)
            else:
                shutil.copy2(entry.path, target)
            imported.append(entry.name)
        self.send_json({"success": True, "imported": imported, "count": len(imported)})

    def open_in_file_manager(self, target):
        try:
            if core.IS_WSL:
                exe = shutil.which("explorer.exe") or "/mnt/c/Windows/explorer.exe"
                win_path = core.to_display_path(target)
                subprocess.Popen([exe, win_path])
                return {"success": True, "path": win_path}
            if core.IS_WINDOWS:
                os.startfile(target)  # type: ignore[attr-defined]
                return {"success": True, "path": target}
            if core.IS_MACOS:
                subprocess.Popen(["open", target])
                return {"success": True, "path": target}
            subprocess.Popen(["xdg-open", target])
            return {"success": True, "path": target}
        except Exception as exc:
            return {"success": False, "error": str(exc)}

    def serve_app(self):
        content = None
        for path in [APP_HTML] + APP_HTML_FALLBACKS:
            try:
                with open(path, "rb") as fh:
                    content = fh.read()
                break
            except Exception:
                continue
        if content is None:
            content = (b"<html><body><h1>OpenCode Station</h1>"
                       b"<p>terminal.html is missing. Run setup.bat / setup.sh.</p></body></html>")
        self.send_bytes(content, "text/html; charset=utf-8")


# ---------------------------------------------------------------------------
# Startup
# ---------------------------------------------------------------------------

def _already_running(port):
    import socket
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.4):
            pass
    except Exception:
        return False
    try:
        import urllib.request
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/ping", timeout=1.2) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("app") == core.APP_NAME
    except Exception:
        return True


def run():
    global PORT, HOST, _TERMINAL_STARTED
    parser = argparse.ArgumentParser(description="OpenCode Station GUI server")
    parser.add_argument("--port", type=int, default=PORT)
    parser.add_argument("--host", default=HOST)
    parser.add_argument("--no-terminal", action="store_true",
                        help="do not start ttyd automatically")
    parser.add_argument("--no-browser", action="store_true")
    args = parser.parse_args()
    PORT, HOST = args.port, args.host

    if _already_running(PORT):
        print(f"[i] OpenCode Station уже запущена на http://localhost:{PORT}")
        return 0

    if not args.no_terminal:
        ok, result = core.start_terminal(core.get_active_env_name(), None, TERMINAL_PORT,
                                         run_opencode=False)
        if ok:
            _TERMINAL_STARTED = True
            print(f"[i] Терминал: http://localhost:{TERMINAL_PORT}")
        else:
            print(f"[!] Терминал не запущен: {result}")

    core.write_json(os.path.join(core.RUN_DIR, "gui.json"),
                    {"pid": os.getpid(), "port": PORT, "host": HOST,
                     "started": core._now()})

    print(f"[*] OpenCode Station {core.APP_VERSION} · {core.PLATFORM}")
    print(f"    Данные: {core.STATE_DIR}")
    print(f"    GUI:    http://localhost:{PORT}")
    try:
        server = ThreadingHTTPServer((HOST, PORT), GUIRequestHandler)
    except OSError as exc:
        print(f"[!] Не удалось занять порт {PORT}: {exc}")
        return 1
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[i] Остановка сервера...")
    finally:
        server.server_close()
        if _TERMINAL_STARTED:
            core.stop_terminal()
        try:
            os.remove(os.path.join(core.RUN_DIR, "gui.json"))
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(run())
