            json.dump(opencode_json, f, indent=2)

        if ws_dir and os.path.exists(ws_dir):
            ws_cfg = os.path.join(ws_dir, ".opencode")
            os.makedirs(ws_cfg, exist_ok=True)
            with open(os.path.join(ws_cfg, "opencode.json"), "w", encoding="utf-8") as f:
                json.dump(opencode_json, f, indent=2)
    except Exception as e:
        pass


PORT = 7682
HOST = "0.0.0.0"

ENVS_DIR = "/var/envs"
MANIFEST_FILE = os.path.join(ENVS_DIR, "manifest.json")
WIN_PROJECTS_DIR = "/mnt/d/OpenCodeProjects"
if not os.path.exists("/mnt/d"):
    WIN_PROJECTS_DIR = "/mnt/c/OpenCodeProjects"

RANDOM_NAMES = [
    "alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta",
    "omega", "nexus", "prism", "orbit", "quantum", "stellar", "matrix", "vector",
    "phoenix", "titan", "aurora", "nova", "cyber", "shadow", "vortex", "zenith"
]

def to_win_path(p):
    p = os.path.abspath(p)
    if p.startswith("/mnt/d"):
        return ("D:" + p[len("/mnt/d"):]).replace("/", "\\")
    elif p.startswith("/mnt/c"):
        return ("C:" + p[len("/mnt/c"):]).replace("/", "\\")
    elif p.startswith("/home/dev/workspace/default"):
        return ("D:\\OpenCodeProjects\\default" + p[len("/home/dev/workspace/default"):]).replace("/", "\\")
    elif p.startswith("/home/dev/workspace/default"):
        return ("D:\\OpenCodeProjects" + p[len("/home/dev/workspace/default"):]).replace("/", "\\")
    elif p.startswith("/var/envs"):
        return ("\\\\wsl.localhost\\Ubuntu" + p).replace("/", "\\")
    elif p.startswith("/home/dev"):
        return ("\\\\wsl.localhost\\Ubuntu" + p).replace("/", "\\")
    else:
        return ("\\\\wsl.localhost\\Ubuntu" + p).replace("/", "\\")

def to_linux_path(p):
    p = p.strip().strip("'\"")
    if p.lower() in ["d", "d:", "d:\\opencodeprojects", "d:/opencodeprojects"]:
        return "/mnt/d/OpenCodeProjects"
    if len(p) >= 2 and p[1] == ':':
        drive = p[0].lower()
        rest = p[2:].replace("\\", "/").lstrip("/")
        return f"/mnt/{drive}/{rest}"
    p = p.replace("\\", "/")
    return os.path.abspath(os.path.expanduser(p))

def get_env_sessions(home_dir):
    db_path = os.path.join(home_dir, ".local/share/opencode/opencode.db")
    if not os.path.exists(db_path):
        return []
    import sqlite3
    try:
        with tempfile.NamedTemporaryFile(suffix=".db", delete=False) as tmp:
            tmp_path = tmp.name
        shutil.copy2(db_path, tmp_path)
        con = sqlite3.connect(tmp_path)
        cur = con.cursor()
        rows = cur.execute("SELECT id, title, directory, time_updated FROM session_v2 WHERE time_archived IS NULL ORDER BY time_updated DESC LIMIT 15").fetchall()
        con.close()
        os.remove(tmp_path)
        res = []
        for r in rows:
            res.append({
                "id": r[0],
                "title": r[1] or "Сессия OpenCode",
                "directory": r[2] or "",
                "time_updated": r[3]
            })
        return res
    except Exception:
        return []

def ensure_manifest():
    os.makedirs(ENVS_DIR, exist_ok=True)
    if not os.path.exists(MANIFEST_FILE):
        default_mid = "a0a98738b38eea3cc372b5ad3152fd55"
        try:
            with open("/etc/machine-id", "r") as f:
                default_mid = f.read().strip()
        except Exception:
            pass

        data = {
            "active": "default",
            "environments": {
                "default": {
                    "name": "default",
                    "hostname": "workstation-node-714",
                    "machine_id": default_mid,
                    "home": "/home/dev",
                    "workspace": "/home/dev/workspace/default",
                    "workspace_win": "D:\\OpenCodeProjects\\default",
                    "proxy_url": "",
                    "proxy_enabled": False,
                    "created_at": "2026-10-29 21:00:00",
                    "description": "Основная среда по умолчанию"
                }
            }
        }
        with open(MANIFEST_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        return data
    else:
        try:
            with open(MANIFEST_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            envs = data.get("environments", {})
            updated = False
            for name, info in envs.items():
                if "proxy_url" not in info:
                    info["proxy_url"] = ""
                    updated = True
                if "proxy_enabled" not in info:
                    info["proxy_enabled"] = False
                    updated = True
                if name == "default":
                    if info.get("workspace") == "/mnt/d/OpenCodeProjects":
                        info["workspace"] = "/home/dev/workspace/default"
                        info["workspace_win"] = "D:\\OpenCodeProjects"
                        updated = True
                else:
                    if info.get("workspace", "").startswith("/mnt/d/"):
                        info["workspace"] = f"/var/envs/{name}/workspace"
                        info["workspace_win"] = f"D:\\OpenCodeProjects\\{name}"
                        updated = True
            if updated:
                with open(MANIFEST_FILE, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=2, ensure_ascii=False)
            return data
        except Exception:
            return {"active": "default", "environments": {}}

def save_manifest(data):
    with open(MANIFEST_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)

def create_env(name=None):
    data = ensure_manifest()
    envs = data.get("environments", {})
    if not name:
        cand = [n for n in RANDOM_NAMES if n not in envs]
        name = f"{random.choice(cand) if cand else 'node'}-{random.randint(100, 999)}"
    name = "".join(c for c in name if c.isalnum() or c in "-_").lower()
    if not name or name in envs:
        return False, f"Среда '{name}' уже существует или некорректное имя"

    mid = uuid.uuid4().hex
    host = f"node-{name}-{uuid.uuid4().hex[:4]}"
    env_path = os.path.join(ENVS_DIR, name)
    env_home = os.path.join(env_path, "home")
    env_ws = os.path.join(env_path, "workspace")
    win_ws = f"D:\\OpenCodeProjects\\{name}"

    os.makedirs(env_path, exist_ok=True)
    os.makedirs(env_home, exist_ok=True)
    os.makedirs(env_ws, exist_ok=True)

    with open(os.path.join(env_path, "machine-id"), "w") as f:
        f.write(f"{mid}\n")
    with open(os.path.join(env_path, "hostname"), "w") as f:
        f.write(f"{host}\n")

    cfg_dir = os.path.join(env_home, ".config", "opencode")
    os.makedirs(cfg_dir, exist_ok=True)
    with open(os.path.join(cfg_dir, "INSTRUCTIONS.md"), "w", encoding="utf-8") as f:
        f.write(f"# Среда: {name}\n* Machine ID: {mid}\n* Hostname: {host}\n* Сделано Антоном Ковалкиным все права защищены.\n")

    ws_link = os.path.join(env_home, "workspace")
    try:
        if os.path.islink(ws_link) or os.path.exists(ws_link):
            os.remove(ws_link)
        os.symlink(env_ws, ws_link)
    except Exception:
        pass

    with open(os.path.join(env_home, ".bashrc"), "w", encoding="utf-8") as f:
        f.write(f"""export OPENCODE_ENV="{name}"
export HOME="{env_home}"
if [ -f "$HOME/.proxy_config" ]; then . "$HOME/.proxy_config"; fi
if [ -f /etc/profile.d/cmd_mode.sh ]; then . /etc/profile.d/cmd_mode.sh; fi
cd "{env_ws}" 2>/dev/null || true
""")

    readme = os.path.join(env_ws, "README.md")
    if not os.path.exists(readme):
        with open(readme, "w", encoding="utf-8") as f:
            f.write(f"# Проект среды {name} (Linux Workspace)\n* Папка: `{env_ws}`\n* Machine ID: `{mid}`\n* Сделано Антоном Ковалкиным все права защищены.\n")

    try:
        subprocess.run(["chown", "-R", "1000:1000", env_path], capture_output=True)
    except Exception:
        pass

    seed_env_opencode_config(env_home, env_ws)
    now_str = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    envs[name] = {
        "name": name,
        "hostname": host,
        "machine_id": mid,
        "home": env_home,
        "workspace": env_ws,
        "workspace_win": win_ws,
        "proxy_url": "",
        "proxy_enabled": False,
        "created_at": now_str,
        "description": f"Анонимная изолированная среда {name}"
    }
    save_manifest(data)
    set_active_env(name)
    return True, envs[name]

def reset_env(name):
    data = ensure_manifest()
    envs = data.get("environments", {})
    if name not in envs:
        return False, "Среда не найдена"

    new_mid = uuid.uuid4().hex
    new_host = f"node-{name}-{uuid.uuid4().hex[:4]}"

    if name == "default":
        for d in ["/home/dev/.cache", "/home/dev/.local/share/opencode", "/var/envs/default"]:
            if os.path.exists(d):
                shutil.rmtree(d, ignore_errors=True)
        envs["default"]["machine_id"] = new_mid
        envs["default"]["hostname"] = new_host
        save_manifest(data)
        try:
            with open("/etc/machine-id", "w") as f:
                f.write(f"{new_mid}\n")
            with open("/var/lib/dbus/machine-id", "w") as f:
                f.write(f"{new_mid}\n")
        except Exception:
            pass
        return True, {"message": "Кэш среды default очищен, паспорт обновлен", "name": "default", "machine_id": new_mid, "hostname": new_host}
    else:
        env_path = os.path.join(ENVS_DIR, name)
        with open(os.path.join(env_path, "machine-id"), "w") as f:
            f.write(f"{new_mid}\n")
        with open(os.path.join(env_path, "hostname"), "w") as f:
            f.write(f"{new_host}\n")

        home = envs[name]["home"]
        for sub in [".cache", ".local", ".config/opencode"]:
            fp = os.path.join(home, sub)
            if os.path.exists(fp):
                shutil.rmtree(fp, ignore_errors=True)
        os.makedirs(os.path.join(home, ".config", "opencode"), exist_ok=True)

        envs[name]["machine_id"] = new_mid
        envs[name]["hostname"] = new_host
        save_manifest(data)
        return True, {"machine_id": new_mid, "hostname": new_host, "name": name}

def delete_env(name, delete_workspace=False):
    data = ensure_manifest()
    envs = data.get("environments", {})
    if name not in envs:
        return False, "Среда не найдена"
    
    info = envs[name]

    # 1. Clean environment state and cache
    if name == "default":
        for p in ["/home/dev/.local/share/opencode", "/home/dev/.config/opencode", "/home/dev/.cache/opencode", "/var/envs/default"]:
            if os.path.exists(p):
                try:
                    if os.path.isdir(p):
                        shutil.rmtree(p, ignore_errors=True)
                    else:
                        os.remove(p)
                except Exception:
                    pass
    else:
        env_path = os.path.join(ENVS_DIR, name)
        if os.path.exists(env_path):
            shutil.rmtree(env_path, ignore_errors=True)

    # 2. Delete workspace directories if requested
    if delete_workspace:
        if name == "default":
            for ws in ["/home/dev/workspace/default", "/mnt/d/OpenCodeProjects/default"]:
                if os.path.exists(ws):
                    try:
                        shutil.rmtree(ws, ignore_errors=True)
                    except Exception:
                        pass
        else:
            ws_paths = [info.get("workspace"), f"/mnt/d/OpenCodeProjects/{name}", f"/var/envs/{name}/workspace"]
            for ws in ws_paths:
                if ws and os.path.exists(ws):
                    try:
                        shutil.rmtree(ws, ignore_errors=True)
                    except Exception:
                        pass

    # 3. Remove from manifest and select new active
    del envs[name]
    if data.get("active") == name:
        remaining = list(envs.keys())
        data["active"] = remaining[0] if remaining else ""
    save_manifest(data)
    return True, f"Среда '{name}' успешно удалена"

def purge_envs():
    data = ensure_manifest()
    envs = data.get("environments", {})
    to_delete = [n for n in list(envs.keys()) if n != "default"]
    for name in to_delete:
        env_path = os.path.join(ENVS_DIR, name)
        if os.path.exists(env_path):
            shutil.rmtree(env_path, ignore_errors=True)
        del envs[name]
    data["active"] = "default"
    save_manifest(data)
    return True, f"Удалено дополнительных сред: {len(to_delete)}"

def set_active_env(name):
    data = ensure_manifest()
    envs = data.get("environments", {})
    if name not in envs:
        return False, f"Среда '{name}' не существует"
    data["active"] = name
    save_manifest(data)

    # Dynamically apply machine-id to WSL
    mid = envs[name].get("machine_id", "")
    if mid:
        try:
            with open("/etc/machine-id", "w") as f:
                f.write(f"{mid}\n")
            with open("/var/lib/dbus/machine-id", "w") as f:
                f.write(f"{mid}\n")
        except Exception:
            pass

    # Synchronize proxy settings to default /home/dev/.proxy_config so any shell immediately uses it
    env_home = envs[name].get("home", "/home/dev")
    env_proxy = os.path.join(env_home, ".proxy_config")
    dev_proxy = "/home/dev/.proxy_config"
    if os.path.exists(env_proxy):
        try:
            shutil.copy2(env_proxy, dev_proxy)
        except Exception:
            pass
    elif os.path.exists(dev_proxy):
        try:
            os.remove(dev_proxy)
        except Exception:
            pass

    return True, f"Активная среда переключена на '{name}'"

def get_dir_contents(path):
    path = os.path.abspath(os.path.expanduser(path))
    if not os.path.exists(path):
        return []
    items = []
    try:
        for entry in os.scandir(path):
            try:
                st = entry.stat(follow_symlinks=False)
                is_dir = entry.is_dir(follow_symlinks=False)
                is_link = entry.is_symlink()
                mtime = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%d.%m.%Y %H:%M")
                size = st.st_size if not is_dir else 0
                items.append({
                    "name": entry.name,
                    "path": entry.path,
                    "win_path": to_win_path(entry.path),
                    "is_dir": is_dir,
                    "is_link": is_link,
                    "size": size,
                    "mtime": mtime,
                    "ext": os.path.splitext(entry.name)[1].lower() if not is_dir else ""
                })
            except Exception:
                pass
    except Exception:
        pass
    items.sort(key=lambda x: (not x["is_dir"], x["name"].lower()))
    return items

IP_CACHE = {}

def get_cached_env_ip(env_name=None, force=False):
    manifest = ensure_manifest()
    envs = manifest.get("environments", {})
    if not env_name or env_name not in envs:
        env_name = manifest.get("active", "default")
    
    now = time.time()
    cached = IP_CACHE.get(env_name)
    if not force and cached and (now - cached.get("_time", 0) < 60):
        return cached["data"]
    
    info = envs.get(env_name, {})
    proxy_url = info.get("proxy_url", "")
    proxy_enabled = info.get("proxy_enabled", False)
    
    if not force:
        if cached:
            return cached["data"]
        return {
            "status": "success",
            "query": "Нажмите 'Проверить IP'",
            "country": "Определение по клику",
            "city": "",
            "org": "",
            "proxy_active": proxy_enabled and bool(proxy_url),
            "proxy_url": proxy_url,
            "env": env_name
        }
    
    data = check_env_ip(env_name)
    IP_CACHE[env_name] = {"data": data, "_time": now}
    return data

def check_env_ip(env_name=None):
    manifest = ensure_manifest()
    envs = manifest.get("environments", {})
    if not env_name or env_name not in envs:
        env_name = manifest.get("active", "default")

    info = envs.get(env_name, {})
    proxy_url = info.get("proxy_url", "")
    proxy_enabled = info.get("proxy_enabled", False)

    if not proxy_url:
        home_cfg = os.path.join(info.get("home", "/home/dev"), ".proxy_config")
        if os.path.exists(home_cfg):
            try:
                with open(home_cfg) as f:
                    for line in f:
                        if line.startswith("PROXY_URL="):
                            proxy_url = line.split("=", 1)[1].strip().strip('"\'')
                        elif line.startswith("PROXY_ENABLED="):
                            proxy_enabled = "yes" in line.lower()
            except Exception:
                pass

    cmd = ["curl", "-s", "--connect-timeout", "3", "--max-time", "6", "http://ip-api.com/json/?fields=status,message,country,city,query,org"]
    if proxy_enabled and proxy_url:
        cmd.extend(["-x", proxy_url])

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=7)
        if res.returncode == 0 and res.stdout:
            data = json.loads(res.stdout)
            if data.get("status") == "success":
                data["proxy_active"] = proxy_enabled and bool(proxy_url)
                data["proxy_url"] = proxy_url
                data["env"] = env_name
                return data
    except Exception:
        pass

    return {
        "status": "fail",
        "query": "Не удалось определить",
        "country": "Офлайн или ошибка сети",
        "city": "",
        "proxy_active": proxy_enabled and bool(proxy_url),
        "proxy_url": proxy_url,
        "env": env_name
    }

class GUIRequestHandler(BaseHTTPRequestHandler):
    def send_json(self, data, status=200):
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS, DELETE")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()
        self.wfile.write(json.dumps(data, ensure_ascii=False).encode("utf-8"))

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS, DELETE")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)

        if path == "/api/ping" or path == "/api/health":
            self.send_json({"status": "ok", "app": "OpenCode Station", "time": time.time()})
            return

        elif path == "/api/status":
            manifest = ensure_manifest()
            active_env = manifest.get("active", "default")
            my_ip = get_cached_env_ip(active_env, force=False)
            envs = manifest.get("environments", {})
            for name, info in envs.items():
                ws = info.get("workspace", "")
                if os.path.exists(ws):
                    try:
                        info["files_count"] = len(os.listdir(ws))
                    except Exception:
                        info["files_count"] = 0
                else:
                    info["files_count"] = 0

                sessions = get_env_sessions(info.get("home", ""))
                info["sessions"] = sessions
                info["latest_session"] = sessions[0] if sessions else None

            self.send_json({
                "status": "ok",
                "environments": envs,
                "active_env": active_env,
                "network": my_ip,
                "win_projects_dir": WIN_PROJECTS_DIR,
                "win_projects_path": to_win_path(WIN_PROJECTS_DIR)
            })
        elif path == "/api/envs":
            manifest = ensure_manifest()
            envs = manifest.get("environments", {})
            for name, info in envs.items():
                ws = info.get("workspace", "")
                if os.path.exists(ws):
                    try:
                        info["files_count"] = len(os.listdir(ws))
                    except Exception:
                        info["files_count"] = 0
                else:
                    info["files_count"] = 0
                sessions = get_env_sessions(info.get("home", ""))
                info["sessions"] = sessions
                info["latest_session"] = sessions[0] if sessions else None

            self.send_json({
                "environments": envs,
                "active": manifest.get("active", "default")
            })
        elif path == "/api/sessions":
            env_name = query.get("env", ["default"])[0]
            manifest = ensure_manifest()
            env_info = manifest.get("environments", {}).get(env_name, {})
            home_dir = env_info.get("home", "/home/dev")
            sessions = get_env_sessions(home_dir)
            self.send_json({"env": env_name, "sessions": sessions})

        elif path == "/api/proxy":
            env_name = query.get("env", ["default"])[0]
            manifest = ensure_manifest()
            env_info = manifest.get("environments", {}).get(env_name, {})
            ip_check = get_cached_env_ip(env_name, force=True)
            self.send_json({
                "env": env_name,
                "proxy_url": env_info.get("proxy_url", ""),
                "proxy_enabled": env_info.get("proxy_enabled", False),
                "ip_check": ip_check
            })

        elif path == "/api/files":
            manifest = ensure_manifest()
            active_info = manifest.get("environments", {}).get(manifest.get("active", "default"), {})
            default_target = active_info.get("workspace", "/home/dev/workspace/default")
            target = query.get("path", [default_target])[0]
            if not target:
                target = default_target
            items = get_dir_contents(target)
            parent = os.path.dirname(os.path.abspath(target))
            self.send_json({
                "current_path": target,
                "current_win_path": to_win_path(target),
                "parent_path": parent if parent != target else "/",
                "items": items
            })
        elif path == "/api/file/read":
            target = query.get("path", [""])[0]
            if not target or not os.path.exists(target):
                self.send_json({"error": "Файл не найден"}, status=404)
                return
            if os.path.isdir(target):
                self.send_json({"error": "Это папка, а не файл"}, status=400)
                return
            try:
                with open(target, "r", encoding="utf-8", errors="replace") as f:
                    content = f.read(1000000)
                self.send_json({
                    "path": target,
                    "win_path": to_win_path(target),
                    "name": os.path.basename(target),
                    "size": os.path.getsize(target),
                    "content": content
                })
            except Exception as e:
                self.send_json({"error": str(e)}, status=500)
        elif path == "/api/file/download":
            target = query.get("path", [""])[0]
            if not target or not os.path.exists(target) or os.path.isdir(target):
                self.send_response(404)
                self.end_headers()
                return
            filename = os.path.basename(target)
            file_size = os.path.getsize(target)
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Disposition", f'attachment; filename="{filename}"')
            self.send_header("Content-Length", str(file_size))
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            with open(target, "rb") as f:
                shutil.copyfileobj(f, self.wfile)
            return
        elif path == "/api/files/zip":
            target_dir = query.get("dir", ["/home/dev/workspace/default"])[0]
            items_param = query.get("items", [""])[0]
            bio = io.BytesIO()
            with zipfile.ZipFile(bio, "w", zipfile.ZIP_DEFLATED) as zf:
                if items_param:
                    item_names = [it.strip() for it in items_param.split(";") if it.strip()]
                    for iname in item_names:
                        full_p = os.path.join(target_dir, iname)
                        if os.path.exists(full_p):
                            if os.path.isdir(full_p):
                                for root, dirs, files in os.walk(full_p):
                                    for f in files:
                                        fp = os.path.join(root, f)
                                        rel = os.path.relpath(fp, target_dir)
                                        zf.write(fp, rel)
                            else:
                                zf.write(full_p, iname)
                else:
                    if os.path.exists(target_dir):
                        for root, dirs, files in os.walk(target_dir):
                            for f in files:
                                fp = os.path.join(root, f)
                                rel = os.path.relpath(fp, target_dir)
                                zf.write(fp, rel)
            bio.seek(0)
            data = bio.read()
            self.send_response(200)
            self.send_header("Content-Type", "application/zip")
            self.send_header("Content-Disposition", 'attachment; filename="opencode_export.zip"')
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(data)
            return
        elif path == "/api/myip":
            env_name = query.get("env", ["default"])[0]
            self.send_json(check_env_ip(env_name))
        elif path in ["/", "/index.html"]:
            self.serve_app()
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length) if length > 0 else b"{}"

        try:
            req_data = json.loads(body.decode("utf-8")) if body else {}
        except Exception:
            req_data = {}

        if path == "/api/opencode/kill":
            try:
                res = subprocess.run(["/usr/local/bin/kill-opencode"], capture_output=True, text=True, timeout=5)
                self.send_json({"success": True, "message": "Процессы OpenCode успешно остановлены", "output": res.stdout})
            except Exception as e:
                self.send_json({"error": str(e)}, status=500)

        elif path == "/api/export":
            src_paths = req_data.get("paths", [])
            src_dir = req_data.get("src_dir", "/home/dev/workspace/default")
            dest_win = req_data.get("dest_win", "D:\\OpenCodeProjects")
            dest_linux = to_linux_path(dest_win)
            os.makedirs(dest_linux, exist_ok=True)
            copied = []
            if src_paths:
                for p in src_paths:
                    if os.path.exists(p):
                        base = os.path.basename(p.rstrip("/\\"))
                        target = os.path.join(dest_linux, base)
                        if os.path.isdir(p):
                            if os.path.exists(target):
                                shutil.rmtree(target)
                            shutil.copytree(p, target)
                        else:
                            shutil.copy2(p, target)
                        copied.append(base)
            else:
                if os.path.exists(src_dir):
                    for entry in os.scandir(src_dir):
                        if entry.name.startswith("."):
                            continue
                        target = os.path.join(dest_linux, entry.name)
                        if entry.is_dir():
                            if os.path.exists(target):
                                shutil.rmtree(target)
                            shutil.copytree(entry.path, target)
                        else:
                            shutil.copy2(entry.path, target)
                        copied.append(entry.name)
            self.send_json({"success": True, "copied": copied, "count": len(copied), "dest_win": dest_win})

        elif path == "/api/import":
            src_win = req_data.get("src_win", "D:\\OpenCodeProjects")
            dest_linux = req_data.get("dest_linux", "/home/dev/workspace/default")
            src_linux = to_linux_path(src_win)
            if not os.path.exists(src_linux):
                self.send_json({"error": f"Папка {src_win} не найдена"}, status=404)
                return
            os.makedirs(dest_linux, exist_ok=True)
            imported = []
            for entry in os.scandir(src_linux):
                if entry.name.startswith("."):
                    continue
                target = os.path.join(dest_linux, entry.name)
                if entry.is_dir():
                    if os.path.exists(target):
                        shutil.rmtree(target)
                    shutil.copytree(entry.path, target)
                else:
                    shutil.copy2(entry.path, target)
                imported.append(entry.name)
            self.send_json({"success": True, "imported": imported, "count": len(imported)})

        elif path == "/api/envs/create":
            name = req_data.get("name", "").strip()
            ok, res = create_env(name)
            if ok:
                self.send_json({"success": True, "env": res})
            else:
                self.send_json({"success": False, "error": res}, status=400)

        elif path == "/api/envs/reset":
            name = req_data.get("name", "").strip()
            ok, res = reset_env(name)
            if ok:
                self.send_json({"success": True, "result": res})
            else:
                self.send_json({"success": False, "error": res}, status=400)

        elif path == "/api/envs/delete":
            name = req_data.get("name", "").strip()
            del_ws = req_data.get("delete_workspace", False)
            ok, res = delete_env(name, del_ws)
            if ok:
                self.send_json({"success": True, "result": res})
            else:
                self.send_json({"success": False, "error": res}, status=400)

        elif path == "/api/envs/purge":
            ok, res = purge_envs()
            self.send_json({"success": ok, "result": res})

        elif path in ["/api/envs/set_active", "/api/envs/switch"]:
            name = req_data.get("name", "").strip()
            ok, res = set_active_env(name)
            if ok:
                self.send_json({"success": True, "result": res})
            else:
                self.send_json({"success": False, "error": res}, status=400)

        elif path == "/api/files/upload":
            dest_dir = req_data.get("dir", "/home/dev/workspace/default")
            filename = req_data.get("name", "uploaded_file")
            b64_content = req_data.get("content_base64", "")
            if not b64_content:
                self.send_json({"error": "Пустое содержимое"}, status=400)
                return
            try:
                os.makedirs(dest_dir, exist_ok=True)
                raw_data = base64.b64decode(b64_content)
                target_path = os.path.join(dest_dir, filename)
                with open(target_path, "wb") as f:
                    f.write(raw_data)
                self.send_json({"success": True, "path": target_path, "win_path": to_win_path(target_path)})
            except Exception as e:
                self.send_json({"error": str(e)}, status=500)

        elif path == "/api/files/write":
            file_path = req_data.get("path", "")
            content = req_data.get("content", "")
            if not file_path:
                self.send_json({"error": "Путь не указан"}, status=400)
                return
            try:
                os.makedirs(os.path.dirname(file_path), exist_ok=True)
                with open(file_path, "w", encoding="utf-8") as f:
                    f.write(content)
                self.send_json({"success": True})
            except Exception as e:
                self.send_json({"error": str(e)}, status=500)

        elif path == "/api/files/copy":
            src = req_data.get("src", "")
            dst = req_data.get("dst", "")
            if not src or not dst or not os.path.exists(src):
                self.send_json({"error": "Исходный файл или папка не существует"}, status=400)
                return
            try:
                if os.path.isdir(src):
                    dest_dir = os.path.join(dst, os.path.basename(src))
                    if os.path.exists(dest_dir):
                        shutil.rmtree(dest_dir)
                    shutil.copytree(src, dest_dir)
                else:
                    os.makedirs(dst, exist_ok=True)
                    shutil.copy2(src, dst)
                self.send_json({"success": True})
            except Exception as e:
                self.send_json({"error": str(e)}, status=500)

        elif path == "/api/files/delete":
            target = req_data.get("path", "")
            if not target or not os.path.exists(target):
                self.send_json({"error": "Файл не найден"}, status=404)
                return
            try:
                if os.path.isdir(target):
                    shutil.rmtree(target, ignore_errors=True)
                else:
                    os.remove(target)
                
                # If default directory was deleted, also clean mirror directory
                if target.rstrip("/\\").endswith("default"):
                    for mirror in ["/home/dev/workspace/default", "/mnt/d/OpenCodeProjects/default"]:
                        if os.path.exists(mirror):
                            shutil.rmtree(mirror, ignore_errors=True)

                self.send_json({"success": True})
            except Exception as e:
                self.send_json({"error": str(e)}, status=500)

        elif path == "/api/files/delete_batch":
            targets = req_data.get("paths", [])
            deleted = 0
            for t in targets:
                if os.path.exists(t):
                    try:
                        if os.path.isdir(t):
                            shutil.rmtree(t)
                        else:
                            os.remove(t)
                        deleted += 1
                    except Exception:
                        pass
            self.send_json({"success": True, "deleted_count": deleted})

        elif path == "/api/files/mkdir":
            target = req_data.get("path", "")
            if not target:
                self.send_json({"error": "Путь не указан"}, status=400)
                return
            try:
                os.makedirs(target, exist_ok=True)
                self.send_json({"success": True})
            except Exception as e:
                self.send_json({"error": str(e)}, status=500)

        elif path == "/api/open_explorer":
            target = req_data.get("path", WIN_PROJECTS_DIR)
            win_p = to_win_path(target)
            try:
                subprocess.Popen(["/mnt/c/Windows/explorer.exe", win_p])
                self.send_json({"success": True, "path": win_p})
            except Exception as e:
                self.send_json({"error": str(e)}, status=500)

        elif path == "/api/proxy/set":
            env_name = req_data.get("env", "default").strip()
            url = req_data.get("url", "").strip()
            enable = req_data.get("enable", True)

            if url and "://" not in url:
                url = f"http://{url}"

            manifest = ensure_manifest()
            envs = manifest.get("environments", {})
            if env_name in envs:
                envs[env_name]["proxy_url"] = url
                envs[env_name]["proxy_enabled"] = bool(enable)
                save_manifest(manifest)

                # Write to env home .proxy_config
                home_dir = envs[env_name].get("home", "/home/dev")
                cfg_file = os.path.join(home_dir, ".proxy_config")
                try:
                    state = "yes" if enable else "no"
                    with open(cfg_file, "w") as f:
                        f.write(f'PROXY_ENABLED="{state}"\nPROXY_URL="{url}"\n')
                except Exception:
                    pass

                # If SOCKS proxy enabled, ensure local bridge is started
                if enable and url and any(url.lower().startswith(s) for s in ["socks5://", "socks5h://", "socks4://", "socks://"]):
                    try:
                        subprocess.run(["/usr/local/bin/opencode-proxy-bridge", "start", url, "10800"], capture_output=True)
                    except Exception:
                        pass
                elif not enable:
                    try:
                        subprocess.run(["/usr/local/bin/opencode-proxy-bridge", "stop", "10800"], capture_output=True)
                    except Exception:
                        pass

                ip_res = check_env_ip(env_name)
                self.send_json({"success": True, "env": env_name, "ip_check": ip_res})
            else:
                self.send_json({"error": f"Среда '{env_name}' не найдена"}, status=404)

        elif path == "/api/proxy/toggle":
            env_name = req_data.get("env", "default").strip()
            enable = req_data.get("enable", False)

            manifest = ensure_manifest()
            envs = manifest.get("environments", {})
            if env_name in envs:
                envs[env_name]["proxy_enabled"] = bool(enable)
                save_manifest(manifest)

                home_dir = envs[env_name].get("home", "/home/dev")
                cfg_file = os.path.join(home_dir, ".proxy_config")
                try:
                    state = "yes" if enable else "no"
                    lines = []
                    if os.path.exists(cfg_file):
                        with open(cfg_file) as f:
                            lines = [l for l in f if not l.startswith("PROXY_ENABLED=")]
                    lines.insert(0, f'PROXY_ENABLED="{state}"\n')
                    with open(cfg_file, "w") as f:
                        f.writelines(lines)
                except Exception:
                    pass

                url = envs[env_name].get("proxy_url", "")
                if enable and url and any(url.lower().startswith(s) for s in ["socks5://", "socks5h://", "socks4://", "socks://"]):
                    try:
                        subprocess.run(["/usr/local/bin/opencode-proxy-bridge", "start", url, "10800"], capture_output=True)
                    except Exception:
                        pass
                elif not enable:
                    try:
                        subprocess.run(["/usr/local/bin/opencode-proxy-bridge", "stop", "10800"], capture_output=True)
                    except Exception:
                        pass

                ip_res = check_env_ip(env_name)
                self.send_json({"success": True, "env": env_name, "enabled": enable, "ip_check": ip_res})
            else:
                self.send_json({"error": f"Среда '{env_name}' не найдена"}, status=404)
        else:
            self.send_response(404)
            self.end_headers()

    def serve_app(self):
        app_html_path = "/usr/local/share/opencode_gui/index.html"
        if os.path.exists(app_html_path):
            with open(app_html_path, "rb") as f:
                content = f.read()
        else:
            content = b"<h1>OpenCode Workstation GUI</h1><p>Starting UI...</p>"
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(content)

def run():
    print(f"[*] Starting OpenCode Workstation GUI Server v2.6 on http://localhost:{PORT}")
    server = ThreadingHTTPServer((HOST, PORT), GUIRequestHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping server...")
        server.server_close()

if __name__ == "__main__":
    run()
