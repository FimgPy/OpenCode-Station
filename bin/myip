#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Public IP / proxy diagnostic for the active OpenCode Station environment."""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import station_core as core  # noqa: E402


def check_ip():
    env_name = core.get_active_env_name()
    home, workspace = core.env_paths(env_name)
    enabled, url, is_global = core.read_proxy_config(home)
    proxy = url if enabled and url else ""

    print("\n" + "=" * 58)
    print("       Проверка сетевого IP и статуса прокси")
    print("       Сделано Антоном Ковалкиным, все права защищены.")
    print("=" * 58)
    print(f"Среда             : {env_name} ({core.PLATFORM})")
    print(f"Прокси            : {'ВКЛЮЧЕН' if proxy else 'ВЫКЛЮЧЕН'} "
          f"{('(' + proxy + ')') if proxy else '(прямое подключение)'}"
          f"{' [глобальный fallback]' if is_global else ''}")
    print("Запрос внешнего IP...")

    cmd = ["curl", "-sS", "--connect-timeout", "4", "--max-time", "8",
           "http://ip-api.com/json/?fields=status,message,country,countryCode,city,query,org"]
    if proxy:
        cmd = ["curl", "-sS", "--connect-timeout", "4", "--max-time", "8",
               "-x", proxy,
               "http://ip-api.com/json/?fields=status,message,country,countryCode,city,query,org"]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        data = json.loads(proc.stdout.strip()) if proc.returncode == 0 and proc.stdout else {}
    except Exception:
        data = {}

    if data.get("status") != "success":
        try:
            cmd2 = ["curl", "-sS", "--connect-timeout", "4", "--max-time", "8",
                    "https://api.ipify.org?format=json"]
            if proxy:
                cmd2 = ["curl", "-sS", "--connect-timeout", "4", "--max-time", "8",
                        "-x", proxy, "https://api.ipify.org?format=json"]
            proc2 = subprocess.run(cmd2, capture_output=True, text=True, timeout=10)
            ip = json.loads(proc2.stdout.strip()).get("ip") if proc2.returncode == 0 else ""
            data = {"status": "success" if ip else "fail", "query": ip,
                    "country": "Определено через ipify", "city": "", "org": ""}
        except Exception:
            data = {"status": "fail"}

    if data.get("status") != "success":
        print("\n[!] Не удалось получить ответ из интернета.")
        if proxy:
            print(f"    Прокси {proxy} недоступен или перехватывает TLS.")
            print("    Отключить: proxy off    Сменить: proxy set <url>")
        else:
            print("    Проверьте сетевое подключение.")
        print("=" * 58 + "\n")
        return 1

    city = data.get("city", "")
    country = data.get("country", "-")
    location = f"{country}, {city}" if city else country
    print("\nРезультат:")
    print(f"  Внешний IP       : {data.get('query', '-')}")
    print(f"  Геолокация       : {location}")
    if data.get("org"):
        print(f"  Провайдер        : {data['org']}")
    if proxy:
        tls = core.proxy_tls_check(proxy, timeout=8)
        print(f"  TLS-проверка     : {'OK' if tls.get('ok') else 'ОШИБКА — ' + tls.get('error', '')}")
    print("-" * 58)
    if proxy:
        print("[✓] Трафик маршрутизируется через прокси.")
    else:
        print("[i] Прямое подключение. Задайте прокси: proxy set <url> && proxy on")
    print("=" * 58 + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(check_ip())
