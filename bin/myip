#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Утилита проверки публичного IP и статуса прокси через curl.
Сделано Антоном Ковалкиным все права защищены.
"""
import os
import sys
import json
import subprocess

def check_ip():
    proxy_env = os.environ.get("http_proxy") or os.environ.get("all_proxy") or os.environ.get("HTTP_PROXY")
    
    print("\n==================================================")
    print("      Проверка сетевого IP и статуса прокси       ")
    print("  Сделано Антоном Ковалкиным все права защищены.  ")
    print("==================================================")

    if proxy_env:
        print(f"Режим прокси      : ВКЛЮЧЕН ({proxy_env})")
    else:
        print("Режим прокси      : ОТКЛЮЧЕН (Прямое подключение)")

    print("Запрос внешнего IP...")
    
    cmd = ["curl", "-s", "--connect-timeout", "4", "--max-time", "7", "http://ip-api.com/json/?fields=status,message,country,city,query,org"]
    if proxy_env:
        cmd.extend(["-x", proxy_env])

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=8)
        data = None
        if res.returncode == 0 and res.stdout:
            try:
                data = json.loads(res.stdout.strip())
            except Exception:
                pass

        if not data or data.get("status") != "success":
            # Fallback to https://api.ipify.org
            cmd2 = ["curl", "-s", "--connect-timeout", "4", "--max-time", "7", "https://api.ipify.org?format=json"]
            if proxy_env:
                cmd2.extend(["-x", proxy_env])
            res2 = subprocess.run(cmd2, capture_output=True, text=True, timeout=8)
            if res2.returncode == 0 and res2.stdout:
                ip_data = json.loads(res2.stdout.strip())
                data = {"status": "success", "query": ip_data.get("ip"), "country": "Не определено", "city": ""}
            else:
                raise Exception("Proxy unreachable or timed out")

    except Exception:
        print("\n[!] ОШИБКА: Не удалось получить ответ из интернета!")
        if proxy_env:
            print(f"Причина: Заданный прокси ({proxy_env}) недоступен или не отвечает.")
            print("Чтобы отключить:  proxy off")
            print("Чтобы сменить:    proxy set <http://хост:порт или socks5://хост:порт>")
        else:
            print("Причина: Нет доступа к сети")
        print("==================================================\n")
        return

    ip = data.get("query", "-")
    country = data.get("country", "-")
    city = data.get("city", "")
    org = data.get("org", "")
    location = f"{country}, {city}" if city else country

    print("\nРезультат:")
    print(f"  Внешний IP-адрес : {ip}")
    print(f"  Геолокация       : {location}")
    if org:
        print(f"  Провайдер        : {org}")
    print("--------------------------------------------------")
    if proxy_env:
        print("[✓] Трафик успешно маршрутизируется через прокси!")
    else:
        print("[i] Для смены IP задайте рабочий прокси: proxy set <url>")
        print("    Затем включите его командой:         proxy on")
    print("==================================================\n")

if __name__ == "__main__":
    check_ip()
