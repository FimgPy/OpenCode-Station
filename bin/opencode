#!/usr/bin/env bash
# OpenCode execution wrapper v4.0 (Independent Anonymous Environments)
# Сделано Антоном Ковалкиным все права защищены.

# 1. Определение активной среды
cur_env="${OPENCODE_ENV}"
if [ -z "$cur_env" ]; then
    if [ -f "/var/envs/manifest.json" ]; then
        cur_env=$(python3 -c "import json; d=json.load(open('/var/envs/manifest.json')); print(d.get('active', 'default'))" 2>/dev/null)
    fi
fi
if [ -z "$cur_env" ]; then
    cur_env="default"
fi
export OPENCODE_ENV="$cur_env"

# 2. Определение домашней директории среды для полной изоляции кэша и настроек
if [ "$cur_env" = "default" ]; then
    ENV_HOME="/home/dev"
    ENV_WS="/home/dev/workspace/default"
else
    ENV_HOME="/var/envs/${cur_env}/home"
    ENV_WS="/var/envs/${cur_env}/workspace"
fi

export HOME="$ENV_HOME"
export XDG_DATA_HOME="${ENV_HOME}/.local/share"
export XDG_CONFIG_HOME="${ENV_HOME}/.config"
export XDG_STATE_HOME="${ENV_HOME}/.local/state"
export XDG_CACHE_HOME="${ENV_HOME}/.cache"
mkdir -p "${XDG_DATA_HOME}" "${XDG_CONFIG_HOME}" "${XDG_STATE_HOME}" "${XDG_CACHE_HOME}" 2>/dev/null

# 3. Гарантированное подавление всплывающих окон лимитов
mkdir -p "${XDG_STATE_HOME}/opencode/latest/tui" "${XDG_CONFIG_HOME}/opencode" 2>/dev/null
echo '{"lastSeenAt":9999999999999,"dontShow":true}' > "${XDG_STATE_HOME}/opencode/latest/tui/go-upsell.json" 2>/dev/null || true

# 4. Чистая преднастройка: НЕ форсируем платную/чужую модель. Если есть старый big-pickle - удаляем.
if [ -f "${XDG_STATE_HOME}/opencode/model.json" ]; then
    if grep -q "big-pickle" "${XDG_STATE_HOME}/opencode/model.json" 2>/dev/null; then
        rm -f "${XDG_STATE_HOME}/opencode/model.json" 2>/dev/null || true
    fi
fi

if [ ! -f "${XDG_CONFIG_HOME}/opencode/opencode.json" ]; then
    cat << 'EOF_CFG' > "${XDG_CONFIG_HOME}/opencode/opencode.json" 2>/dev/null || true
{
  "$schema": "https://opencode.ai/config.json"
}
EOF_CFG
fi

# 5. Аппаратная изоляция: динамическая запись Machine ID текущей среды
mid_file="/var/envs/${cur_env}/machine-id"
mid=""
if [ -f "$mid_file" ]; then
    mid=$(cat "$mid_file" 2>/dev/null | tr -d '\r\n ')
fi
if [ -z "$mid" ]; then
    mid=$(head -c 16 /dev/urandom | md5sum | head -c 32)
    mkdir -p "/var/envs/${cur_env}" 2>/dev/null
    echo "$mid" > "$mid_file" 2>/dev/null || true
fi

echo "$mid" > /etc/machine-id 2>/dev/null || true
echo "$mid" > /var/lib/dbus/machine-id 2>/dev/null || true

# 6. Удаление разделяемых файлов службы для полной изоляции среды
rm -f "${XDG_STATE_HOME}/opencode/service.json" "${XDG_CONFIG_HOME}/opencode/service.json" 2>/dev/null || true

# 7. Настройка прокси (локальный или глобальный)
proxy_notice=""
if [ -f "$ENV_HOME/.proxy_config" ]; then
    source "$ENV_HOME/.proxy_config"
fi

# Если для среды локально прокси не включен, проверяем глобальный прокси
if [ "$PROXY_ENABLED" != "yes" ] && [ -f "/var/envs/global_proxy.json" ]; then
    g_enabled=$(python3 -c "import json; d=json.load(open('/var/envs/global_proxy.json')); print('yes' if d.get('enabled') else 'no')" 2>/dev/null || echo "no")
    if [ "$g_enabled" = "yes" ]; then
        PROXY_ENABLED="yes"
        PROXY_URL=$(python3 -c "import json; d=json.load(open('/var/envs/global_proxy.json')); print(d.get('url',''))" 2>/dev/null || echo "")
    fi
fi

if [ "$PROXY_ENABLED" = "yes" ] && [ -n "$PROXY_URL" ]; then
    case "$PROXY_URL" in
        *://*) ;;
        *) PROXY_URL="http://${PROXY_URL}" ;;
    esac

    case "$PROXY_URL" in
        socks5://*|socks5h://*|socks4://*|socks4a://*|socks://*)
            /usr/local/bin/opencode-proxy-bridge start "$PROXY_URL" 10800 >/dev/null 2>&1
            effective_proxy="http://127.0.0.1:10800"
            ;;
        *)
            effective_proxy="$PROXY_URL"
            ;;
    esac

    export HTTP_PROXY="$effective_proxy"
    export HTTPS_PROXY="$effective_proxy"
    export http_proxy="$effective_proxy"
    export https_proxy="$effective_proxy"
    export ALL_PROXY="$effective_proxy"
    export all_proxy="$effective_proxy"
else
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
fi

export NO_PROXY="127.0.0.1,localhost,::1"
export no_proxy="127.0.0.1,localhost,::1"

# 8. Переход в рабочую папку среды
if [ -d "$ENV_WS" ]; then
    cd "$ENV_WS" 2>/dev/null || true
fi

# 9. Информационная шапка при интерактивном запуске
if [ -t 0 ] && [ "$1" != "run" ] && [ "$1" != "api" ] && [ "$1" != "models" ]; then
    echo "=============================================================================="
    echo "  OpenCode Station [Сделано Антоном Ковалкиным все права защищены]"
    echo "  Среда: [${cur_env}] | Machine ID: ${mid:0:12}..."
    echo "  Рабочая папка: $(pwd)"
    if [ -n "$HTTP_PROXY" ]; then
        echo "  Сеть: Прокси активен (${HTTP_PROXY})"
    else
        echo "  Сеть: Прямое изолированное подключение"
    fi
    echo "  [Подсказка] Выход в терминал: введите /exit или нажмите Ctrl+D"
    echo "=============================================================================="
fi

# 10. Запуск изолированного OpenCode
exec /usr/local/bin/opencode-bin "$@"
