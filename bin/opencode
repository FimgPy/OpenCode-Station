#!/usr/bin/env bash
# OpenCode Station launcher v3.0 (portable: Linux / WSL / macOS)
#
# Isolation model:
#   * every environment has its own HOME, XDG dirs, workspace and OpenCode DB;
#   * on Linux/WSL with namespaces available, machine-id/hostname are bound
#     only inside a private mount+UTS namespace (the host is never modified);
#   * on macOS user-space isolation is used (unique HOME/XDG, no global writes).
#
# Made by Anton Kovalkin. All rights reserved.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
export OPENCODE_STATION_ROOT="${OPENCODE_STATION_ROOT:-$ROOT_DIR}"
CORE="$SCRIPT_DIR/station_core.py"

if ! command -v python3 >/dev/null 2>&1; then
    echo "[!] python3 не найден. Установите Python 3.8+ и повторите запуск." >&2
    exit 1
fi

# Resolve the active environment from the manifest unless explicitly pinned.
if [ -z "${OPENCODE_ENV:-}" ]; then
    OPENCODE_ENV="$(python3 -c 'import sys; sys.path.insert(0, "'"$SCRIPT_DIR"'"); import station_core; print(station_core.get_active_env_name())' 2>/dev/null || echo default)"
fi
export OPENCODE_ENV

# Portable environment descriptor (paths, proxy, binary, platform).
CORE_ENV="$(python3 "$CORE" shell-exports "$OPENCODE_ENV" 2>/dev/null || true)"
if [ -n "$CORE_ENV" ]; then
    eval "$CORE_ENV"
else
    echo "[!] Не удалось прочитать реестр сред ($CORE)." >&2
    echo "    Проверьте права на OPENCODE_STATION_DATA и наличие Python 3." >&2
    exit 1
fi

export HOME="${ENV_HOME:-$HOME}"
export OPENCODE_TEST_HOME="$HOME"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_STATE_HOME="${HOME}/.local/state"
export XDG_CACHE_HOME="${HOME}/.cache"
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_CLAUDE_CODE=1
export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1
export OPENCODE_DISABLE_CHANNEL_DB=1

WORKSPACE="${ENV_WS:-$PWD}"
mkdir -p "$HOME" "$WORKSPACE" "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" \
         "$XDG_STATE_HOME" "$XDG_CACHE_HOME" "${ENV_DATA:-$ROOT_DIR}/run" \
         "$XDG_STATE_HOME/opencode/latest/tui" "$XDG_CONFIG_HOME/opencode" 2>/dev/null || true

# Suppress the Go upsell modal (server-side limits still apply).
printf '%s\n' '{"lastSeenAt":9999999999999,"dontShow":true}' \
    > "$XDG_STATE_HOME/opencode/latest/tui/go-upsell.json" 2>/dev/null || true

if [ ! -f "$XDG_CONFIG_HOME/opencode/opencode.json" ]; then
    printf '%s\n' '{"$schema":"https://opencode.ai/config.json"}' \
        > "$XDG_CONFIG_HOME/opencode/opencode.json" 2>/dev/null || true
fi

# Never reuse the shared background service DB.
rm -f "$XDG_STATE_HOME/opencode/service.json" \
      "$XDG_CONFIG_HOME/opencode/service.json" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------
PROXY_EFFECTIVE=""
if [ "${ENV_PROXY_ENABLED:-no}" = "yes" ] && [ -n "${ENV_PROXY_URL:-}" ]; then
    proxy_url="$ENV_PROXY_URL"
    if [[ "$proxy_url" == socks5://* || "$proxy_url" == socks5h://* || \
          "$proxy_url" == socks4://* || "$proxy_url" == socks4a://* || \
          "$proxy_url" == socks://* ]]; then
        PROXY_EFFECTIVE="$(python3 -c 'import sys; sys.path.insert(0, "'"$SCRIPT_DIR"'"); import station_core; print(station_core.start_bridge("'"$OPENCODE_ENV"'", "'"$proxy_url"'"))' 2>/dev/null || true)"
    else
        PROXY_EFFECTIVE="$proxy_url"
    fi

    if [ -n "$PROXY_EFFECTIVE" ] && [ "${OPENCODE_PROXY_PREFLIGHT:-1}" != "0" ]; then
        if ! PREFLIGHT_ERR="$(python3 "$CORE" proxy-preflight "$PROXY_EFFECTIVE" 2>&1)"; then
            echo "=============================================================================="
            echo "  [!] Прокси не прошёл проверку TLS: $PROXY_EFFECTIVE"
            echo "      $PREFLIGHT_ERR"
            echo "      OpenCode не будет использовать этот прокси (иначе возникает"
            echo "      SELF_SIGNED_CERT_IN_CHAIN). Выберите прокси с чистым HTTPS."
            echo "=============================================================================="
            PROXY_EFFECTIVE=""
        fi
    fi

    if [ -n "$PROXY_EFFECTIVE" ]; then
        export HTTP_PROXY="$PROXY_EFFECTIVE" HTTPS_PROXY="$PROXY_EFFECTIVE"
        export http_proxy="$PROXY_EFFECTIVE" https_proxy="$PROXY_EFFECTIVE"
        export ALL_PROXY="$PROXY_EFFECTIVE" all_proxy="$PROXY_EFFECTIVE"
        export OPENCODE_PROXY_ACTIVE="$PROXY_EFFECTIVE"
        echo "[i] Прокси активен: $PROXY_EFFECTIVE (среда $OPENCODE_ENV)"
    else
        unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
        export OPENCODE_PROXY_ACTIVE=""
    fi
else
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
    export OPENCODE_PROXY_ACTIVE=""
fi

export NO_PROXY="127.0.0.1,localhost,::1,local.home"
export no_proxy="$NO_PROXY"

cd "$WORKSPACE" 2>/dev/null || true

# Remember the launcher PID for reliable environment cleanup (GUI/ttyd).
if [ -n "${ENV_DATA:-}" ]; then
    mkdir -p "$ENV_DATA/run" 2>/dev/null || true
    printf '{"pids":[%d],"env":"%s","started":"%s"}\n' "$$" "$OPENCODE_ENV" \
        "$(date '+%Y-%m-%d %H:%M:%S')" \
        > "$ENV_DATA/run/env-${OPENCODE_ENV}.json" 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------
USE_STANDALONE=1
case "${1:-}" in
    serve|service|upgrade|update|uninstall|acp|completions|models|auth|api|debug|plugin|mcp|session|stats|pair|reload|--help|-h|--version|-v)
        USE_STANDALONE=0
        ;;
esac
for arg in "$@"; do
    case "$arg" in
        --standalone|--server|--server=*)
            USE_STANDALONE=0
            ;;
    esac
done

RUN_ARGS=()
if [ "$USE_STANDALONE" -eq 1 ]; then
    RUN_ARGS+=("--standalone")
fi
RUN_ARGS+=("$@")

if [ -t 0 ] && [ "${1:-}" != "run" ] && [ "${1:-}" != "api" ] && \
   [ "${1:-}" != "models" ] && [ "${1:-}" != "auth" ]; then
    echo "=============================================================================="
    echo "  OpenCode Station [${ENV_PLATFORM:-linux} · изолированная среда]"
    echo "  Среда: [${OPENCODE_ENV}] | Hostname: ${ENV_HOSTNAME:-?} | ID: $(printf '%s' "${ENV_MACHINE_ID:-?}" | cut -c1-12)..."
    echo "  Рабочая папка: $(pwd)"
    if [ -n "$PROXY_EFFECTIVE" ]; then
        echo "  Прокси: включён (${PROXY_EFFECTIVE})"
    else
        echo "  Прокси: выключен (прямое подключение)"
    fi
    echo "  [Подсказка] Выход: /exit или Ctrl+D"
    echo "=============================================================================="
fi

OPENCODE_BIN="${ENV_OPENCODE_BIN:-}"
if [ -z "$OPENCODE_BIN" ] || [ ! -x "$OPENCODE_BIN" ]; then
    if command -v opencode >/dev/null 2>&1; then
        OPENCODE_BIN="$(command -v opencode)"
    elif [ -x "$SCRIPT_DIR/opencode-bin" ]; then
        OPENCODE_BIN="$SCRIPT_DIR/opencode-bin"
    else
        echo "[!] Бинарник OpenCode не найден. Запустите setup.sh / setup.bat." >&2
        exit 127
    fi
fi

# ---------------------------------------------------------------------------
# Linux/WSL namespace isolation (optional, never mutates the host)
# ---------------------------------------------------------------------------
if [ "${ENV_ISOLATION:-user}" = "unshare" ] && [ "${OPENCODE_STATION_NO_NS:-0}" != "1" ]; then
    TARGET_UID="$(id -u)"
    TARGET_GID="$(id -g)"
    SUDO=""
    if [ "$TARGET_UID" -ne 0 ]; then
        if sudo -n true 2>/dev/null; then
            SUDO="sudo -n"
        else
            echo "[i] Нет passwordless sudo: используется user-space изоляция (HOME/XDG)."
        fi
    fi

    if [ "$TARGET_UID" -eq 0 ] || [ -n "$SUDO" ]; then
        PRESERVE_VARS="HOME,OPENCODE_TEST_HOME,OPENCODE_STATION_ROOT,OPENCODE_STATION_DATA,OPENCODE_ENV,OPENCODE_PROXY_ACTIVE,XDG_DATA_HOME,XDG_CONFIG_HOME,XDG_STATE_HOME,XDG_CACHE_HOME,OPENCODE_DISABLE_AUTOUPDATE,OPENCODE_DISABLE_CLAUDE_CODE,OPENCODE_DISABLE_CLAUDE_CODE_SKILLS,OPENCODE_DISABLE_CHANNEL_DB,OPENCODE_MODEL,OPENCODE_API_KEY,GEMINI_API_KEY,GOOGLE_API_KEY,GROQ_API_KEY,OPENROUTER_API_KEY,DEEPSEEK_API_KEY,HTTP_PROXY,HTTPS_PROXY,http_proxy,https_proxy,ALL_PROXY,all_proxy,NO_PROXY,no_proxy,TERM,COLORTERM,LANG,LC_ALL,PATH"
        # shellcheck disable=SC2086
        exec $SUDO --preserve-env="$PRESERVE_VARS" unshare --mount --uts bash -c '
            env_host="$1"; mid_src="$2"; host_src="$3"; t_uid="$4"; t_gid="$5"
            shift 5
            hostname "$env_host" 2>/dev/null || true
            [ -f "$mid_src" ] && [ -e /etc/machine-id ] && mount --bind "$mid_src" /etc/machine-id 2>/dev/null || true
            [ -f "$mid_src" ] && [ -e /var/lib/dbus/machine-id ] && mount --bind "$mid_src" /var/lib/dbus/machine-id 2>/dev/null || true
            [ -f "$host_src" ] && [ -e /etc/hostname ] && mount --bind "$host_src" /etc/hostname 2>/dev/null || true
            if [ "$t_uid" != "0" ] && command -v setpriv >/dev/null 2>&1; then
                exec setpriv --reuid="$t_uid" --regid="$t_gid" --init-groups "$@"
            fi
            exec "$@"
        ' _ "${ENV_HOSTNAME:-node-${OPENCODE_ENV}}" "${ENV_META:-}/machine-id" \
            "${ENV_META:-}/hostname" "$TARGET_UID" "$TARGET_GID" \
            "$OPENCODE_BIN" "${RUN_ARGS[@]}"
    fi
fi

exec "$OPENCODE_BIN" "${RUN_ARGS[@]}"
